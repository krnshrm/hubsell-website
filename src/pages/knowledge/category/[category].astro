---
// LEARNING NOTES: a knowledge center category page
// ------------------------------------------------
// One page per category, so a category is a real, linkable destination rather
// than just a heading on the hub. It also gives the article breadcrumb a
// middle step to point at.
//
// The route sits under /knowledge/category/ rather than /knowledge/ because
// /knowledge/[slug] already claims that level for articles; two dynamic routes
// on the same segment would collide.
import { getCollection } from 'astro:content';
import KnowledgeLayout from '../../../layouts/KnowledgeLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumbSchema } from '../../../data/seo';
import { KNOWLEDGE_CATEGORIES } from '../../../data/knowledge';

export async function getStaticPaths() {
  const articles = await getCollection('knowledge', (a) => !a.data.draft);
  // Only build a page for a category that actually has articles, so we never
  // ship an empty shell for a category that is still just a plan.
  return KNOWLEDGE_CATEGORIES
    .filter((cat) => articles.some((a) => a.data.category === cat.name))
    .map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;
const all = await getCollection('knowledge', (a) => !a.data.draft);
const articles = all
  .filter((a) => a.data.category === cat.name)
  .sort((x, y) => (x.data.order - y.data.order) || x.data.title.localeCompare(y.data.title));

const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Knowledge', url: '/knowledge' },
  { name: cat.name, url: `/knowledge/category/${cat.slug}` },
]);
---
<KnowledgeLayout
  title={`${cat.name} | hubsell Knowledge center`}
  description={cat.description}
  activeCategory={cat.name}
>
  <JsonLd slot="head" schema={crumbs} />

  <div class="kbcat">
    <nav class="kb-crumbs" aria-label="Breadcrumb">
      <a href="/knowledge">All articles</a><span class="sep">/</span>
      <span class="here">{cat.name}</span>
    </nav>

    <h1 class="kb-title">{cat.name}</h1>
    <p class="kb-summary">{cat.description}</p>
    <p class="kbcat__count">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</p>

    <ul class="kbcat__list">
      {articles.map((a) => (
        <li>
          <a href={`/knowledge/${a.id}`}>
            <span class="kbcat__t">{a.data.title}</span>
            {a.data.description && <span class="kbcat__d">{a.data.description}</span>}
            <span class="kbcat__m">
              {a.data.series && a.data.seriesStep && a.data.seriesTotal
                ? `Step ${a.data.seriesStep} of ${a.data.seriesTotal}`
                : cat.name}
              {a.data.estMinutes ? ` · ${a.data.estMinutes} min` : ''}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</KnowledgeLayout>

<style is:global>
  .kbcat{max-width:760px}
  .kbcat__count{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-3);margin:0 0 24px}
  .kbcat__list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
  .kbcat__list a{display:block;text-decoration:none;background:var(--kb-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px 20px;transition:border-color .15s}
  .kbcat__list a:hover{border-color:var(--accent-on)}
  .kbcat__t{display:block;font-family:var(--font-head);font-weight:600;font-size:1.02rem;color:var(--text);line-height:1.3;margin-bottom:6px}
  .kbcat__d{display:block;font-size:14px;line-height:1.55;color:var(--text-2);margin-bottom:10px}
  .kbcat__m{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-3)}
</style>
