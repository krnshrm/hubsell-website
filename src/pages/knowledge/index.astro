---
// LEARNING NOTES: the knowledge center hub
// ----------------------------------------
// Search first, because most people arrive with a question rather than a wish
// to browse. Under it: a row of the most-wanted articles, then a card per
// category. Typing in the search box swaps the category grid for a flat list
// of matching articles.
import { getCollection } from 'astro:content';
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbSchema } from '../../data/seo';
import { KNOWLEDGE_CATEGORIES, POPULAR_ARTICLES } from '../../data/knowledge';

const articles = await getCollection('knowledge', (a) => !a.data.draft);

// Category cards, in the order defined in data/knowledge.ts. Empty categories
// are dropped so the hub never advertises a category with nothing behind it.
const groups = KNOWLEDGE_CATEGORIES.map((cat) => ({
  ...cat,
  count: articles.filter((a) => a.data.category === cat.name).length,
})).filter((g) => g.count > 0);

// Popular row: named slugs, in order, skipping any that do not exist.
const popular = POPULAR_ARTICLES
  .map((slug) => articles.find((a) => a.id === slug))
  .filter(Boolean)
  .slice(0, 6);

// Flat list used by the search filter.
const searchable = articles
  .map((a) => ({
    id: a.id,
    title: a.data.title,
    description: a.data.description ?? '',
    category: a.data.category,
    haystack: `${a.data.title} ${a.data.description ?? ''} ${a.data.category}`.toLowerCase(),
  }))
  .sort((x, y) => x.title.localeCompare(y.title));

const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Knowledge', url: '/knowledge' },
]);
---
<KnowledgeLayout
  title="Knowledge center | hubsell"
  description="Guides and step-by-step help for hubsell: set up your account, connect your channels, source data, and launch your first flow."
>
  <JsonLd slot="head" schema={crumbs} />

  <div class="kbhub">
    <section class="kbhub__hero">
      <h1 class="kbhub__h1">How can we help?</h1>
      <p class="kbhub__sub">Search for an answer, or browse by topic.</p>

      <div class="kbhub__search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="search" id="kbSearch" placeholder="Search articles" aria-label="Search the knowledge center" autocomplete="off" />
      </div>

      {popular.length > 0 && (
        <div class="kbhub__pop">
          <span class="kbhub__poplabel">Popular</span>
          {popular.map((a) => (
            <a href={`/knowledge/${a.id}`}>{a.data.title}</a>
          ))}
        </div>
      )}
    </section>

    {/* Search results. Hidden until the reader types. */}
    <section class="kbhub__results" id="kbResults" hidden aria-label="Search results">
      <ul class="kbhub__rlist">
        {searchable.map((a) => (
          <li class="kbhub__ritem" data-search={a.haystack}>
            <a href={`/knowledge/${a.id}`}>
              <span class="kbhub__rt">{a.title}</span>
              {a.description && <span class="kbhub__rd">{a.description}</span>}
              <span class="kbhub__rc">{a.category}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="kbhub__empty" id="kbEmpty" hidden>No articles match that search yet.</p>
    </section>

    {/* Browse by category. Hidden while a search is active. */}
    <section class="kbhub__browse" id="kbBrowse" aria-label="Browse by topic">
      <h2 class="kbhub__h2">Browse by topic</h2>
      <ul class="kbhub__cards">
        {groups.map((g) => (
          <li>
            <a href={`/knowledge/category/${g.slug}`}>
              <span class="kbhub__ct">{g.name}</span>
              <span class="kbhub__cd">{g.description}</span>
              <span class="kbhub__cc">{g.count} {g.count === 1 ? 'article' : 'articles'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</KnowledgeLayout>

<style is:global>
  .kbhub{max-width:920px}

  .kbhub__hero{padding:14px 0 6px}
  .kbhub__h1{font-family:var(--font-head);font-weight:600;font-size:clamp(1.9rem,3.4vw,2.4rem);line-height:1.15;letter-spacing:-.02em;color:var(--text);margin:0 0 8px}
  .kbhub__sub{font-size:1.05rem;line-height:1.55;color:var(--text-2);margin:0 0 22px}

  .kbhub__search{display:flex;align-items:center;gap:11px;background:var(--kb-card);border:1px solid var(--border);border-radius:var(--radius);padding:0 16px;max-width:560px}
  .kbhub__search:focus-within{border-color:var(--accent-on);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent-on) 18%,transparent)}
  .kbhub__search svg{width:18px;height:18px;color:var(--text-3);flex:none}
  .kbhub__search input{flex:1;border:0;background:transparent;color:var(--text);font-family:var(--font-body);font-size:1rem;padding:14px 0;outline:none}
  .kbhub__search input::placeholder{color:var(--text-3)}

  .kbhub__pop{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin-top:16px}
  .kbhub__poplabel{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-3)}
  .kbhub__pop a{font-size:13.5px;color:var(--text-2);text-decoration:none;background:var(--kb-card);border:1px solid var(--border);border-radius:999px;padding:6px 13px;transition:border-color .15s,color .15s}
  .kbhub__pop a:hover{color:var(--accent-on);border-color:var(--accent-on)}

  .kbhub__h2{font-family:var(--font-head);font-weight:600;font-size:1.15rem;color:var(--text);margin:44px 0 16px}

  .kbhub__cards{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}
  .kbhub__cards a{display:flex;flex-direction:column;height:100%;text-decoration:none;background:var(--kb-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 22px;transition:border-color .15s}
  .kbhub__cards a:hover{border-color:var(--accent-on)}
  .kbhub__ct{font-family:var(--font-head);font-weight:600;font-size:1.02rem;color:var(--text);margin-bottom:6px}
  .kbhub__cd{font-size:14px;line-height:1.55;color:var(--text-2);margin-bottom:12px}
  .kbhub__cc{margin-top:auto;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-3)}

  .kbhub__results{margin-top:30px}
  .kbhub__rlist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  .kbhub__rlist a{display:block;text-decoration:none;background:var(--kb-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:16px 18px;transition:border-color .15s}
  .kbhub__rlist a:hover{border-color:var(--accent-on)}
  .kbhub__rt{display:block;font-family:var(--font-head);font-weight:600;font-size:.98rem;color:var(--text);line-height:1.3;margin-bottom:5px}
  .kbhub__rd{display:block;font-size:13.5px;line-height:1.5;color:var(--text-2);margin-bottom:8px}
  .kbhub__rc{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-3)}
  .kbhub__ritem[hidden]{display:none}
  .kbhub__empty{margin:18px 0 0;color:var(--text-2);font-size:15px}
</style>

<script>
  // Hub search: filter in memory, swap the category grid for a result list.
  function initHubSearch() {
    const input = document.getElementById('kbSearch') as HTMLInputElement | null;
    const results = document.getElementById('kbResults');
    const browse = document.getElementById('kbBrowse');
    const empty = document.getElementById('kbEmpty');
    if (!input || !results || !browse || !empty) return;

    const items = Array.from(document.querySelectorAll<HTMLElement>('.kbhub__ritem'));

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();

      if (!q) {
        results.hidden = true;
        browse.hidden = false;
        return;
      }

      results.hidden = false;
      browse.hidden = true;

      let hits = 0;
      items.forEach((li) => {
        const hit = (li.getAttribute('data-search') || '').includes(q);
        li.hidden = !hit;
        if (hit) hits++;
      });
      empty.hidden = hits > 0;
    });
  }

  initHubSearch();
  document.addEventListener('astro:page-load', initHubSearch);
</script>
