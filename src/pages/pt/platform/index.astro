---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import PlatformOverviewBody from '../../../components/PlatformOverviewBody.astro';
import { breadcrumbSchema, faqPageSchema } from '../../../data/seo';
import { getPlatformOverview } from '../../../data/platform-i18n';
import { asLocale, localizeUrl, useTranslations } from '../../../i18n/utils';

const L = asLocale(Astro.currentLocale);
const t = useTranslations(L);
const d = getPlatformOverview(L);
const crumbs = breadcrumbSchema([
  { name: t('nav.home'), url: localizeUrl(L, '/') },
  { name: t('nav.platform'), url: localizeUrl(L, '/platform') },
]);
---
<BaseLayout title={d.title} description={d.metaDescription}>
  <JsonLd slot="head" schema={d.faqs ? [crumbs, faqPageSchema(d.faqs)] : crumbs} />
  <PlatformOverviewBody L={L} data={d} />
</BaseLayout>
