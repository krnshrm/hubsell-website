---
// ============================= LEARNING NOTES =============================
// DYNAMIC ROUTE: this one file builds every page under /vs/<slug> ,
// one per entry in the 'comparisons' content collection (schema in
// src/content.config.ts). getStaticPaths() returns the list of pages to
// create; the pattern is explained line by line at the top of
// src/pages/insights/[slug].astro, which is the exemplar to study first.
// Body component(s): src/components/ComparisonDetail.astro.
// JsonLd emits schema.org structured data for search engines (breadcrumbs
// and similar); see src/data/seo.ts for the schema builders.
// ==========================================================================
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ComparisonDetail from '../../components/ComparisonDetail.astro';
import { breadcrumbSchema } from '../../data/seo';
import { getComparisonsPage } from '../../i18n/pages';
import { asLocale, localizeUrl } from '../../i18n/utils';

// Build every comparison (rows are drafted in Webflow but are the launch pages).
export async function getStaticPaths() {
  const items = await getCollection('comparisons');
  return items.map((item) => ({ params: { slug: item.id }, props: { item, items } }));
}
const { item, items } = Astro.props;
const d = item.data;
const L = asLocale(Astro.currentLocale);
const c = getComparisonsPage(L);
const competitor = d.title;
const seoTitle = d.metaTitle || `${competitor} vs hubsell`;
const seoDesc = d.metaDescription || d.heroSubhead || '';
const seoDescFinal = /alternative/i.test(seoDesc) ? seoDesc : `${seoDesc}${c.altPre}${competitor}${c.altPost}`.trim();
const crumbs = breadcrumbSchema([
  { name: c.crumbHome, url: localizeUrl(L, '/') },
  { name: c.crumbComparisons, url: localizeUrl(L, '/comparisons') },
  { name: `${competitor} vs hubsell`, url: localizeUrl(L, `/vs/${item.id}`) },
]);
// LEARNING: built from d.faqs, the same array ComparisonDetail renders as the
// visible accordion, so the schema can never drift from what a visitor sees —
// same rule as the homepage FAQPage schema in src/pages/index.astro. d.faqs is
// optional (see src/content.config.ts), so pages without it just skip the schema.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const schemas = d.faqs && d.faqs.length > 0
  ? [crumbs, {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faqs.map((f: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.answer) },
      })),
    }]
  : crumbs;
---
<BaseLayout title={seoTitle} description={seoDescFinal}>
  <JsonLd slot="head" schema={schemas} />
  <ComparisonDetail item={item} items={items} />
</BaseLayout>
