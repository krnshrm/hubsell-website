---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { softwareApplicationSchema } from '../data/seo';
import { getHome } from '../data/home-i18n';
import { asLocale } from '../i18n/utils';
import HeroScene from '../components/HeroScene.astro';
import CustomerLogos from '../components/CustomerLogos.astro';
import VolumeVsPrecision from '../components/VolumeVsPrecision.astro';
import Comparison from '../components/Comparison.astro';
import ZeroDaySourcing from '../components/ZeroDaySourcing.astro';
import RatingsStrip from '../components/RatingsStrip.astro';
import Pricing from '../components/Pricing.astro';
// import UseCases from '../components/UseCases.astro';  // hidden until its pages ship
// import Features from '../components/Features.astro';  // hidden until its pages ship
import Testimonials from '../components/Testimonials.astro';
// import PublishTrackBeta from '../components/PublishTrackBeta.astro';  // hidden until its pages ship
import Faq from '../components/Faq.astro';
import Insights from '../components/Insights.astro';

// Home page, full section rhythm. Colors alternate so a dark lands early and
// navy/espresso never repeat back to back. Book a demo is the CTA
// throughout; the old waitlist section has been removed.
//
// The description below (and softwareApplicationSchema.description
// in src/data/seo.ts) name all three outreach channels, email, LinkedIn, and phone, // because the homepage body already does (HeroPipelineFlow's step 4, the
// FragmentedStack/Comparison "Email, LinkedIn & phone" row). A short summary that
// undersells what the visible page and structured data already say is exactly what
// makes an AI assistant discard it and write its own instead. The FAQPage schema
// below mirrors the same rule: it is built from the same `faqs` array Faq.astro
// renders, so the accepted answers a search or AI engine may quote always match
// what a visitor actually sees.
const L = asLocale(Astro.currentLocale);
const { faqs } = getHome(L);
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.answer) },
  })),
};
---
<BaseLayout title="Outbound sales platform with live B2B data | hubsell" description="Outbound sales platform: start from a LinkedIn post, event, search or list. hubsell qualifies, verifies contact data and runs LinkedIn, email and calls in one flow.">
  <JsonLd slot="head" schema={[softwareApplicationSchema, faqSchema]} />
  {/* slot="head" sends this into BaseLayout's named head slot, so the
      JSON-LD lands inside <head> rather than the body. */}
  {/* Order follows how a buyer decides: see it working, why fewer prospects
      works, why the data is fresh, why not the alternatives, who uses it, what
      it costs, what is left to ask. FragmentedStack and PipelineSteps were
      taken off the homepage on 2026-10-13 (the comparison and the hero demo
      cover them) and are kept for other pages. */}
  {/*  1 */}<HeroScene />
  {/*  2 */}<CustomerLogos />
  {/*  3 */}<VolumeVsPrecision />
  {/*  4 */}<ZeroDaySourcing />
  {/*  5 */}<Comparison />
  {/*  6 */}<Testimonials />
  {/*  7 */}<RatingsStrip />
  {/*  8 */}<Pricing />
  {/*  9 */}<Faq />
  {/* 10 */}<Insights />
  {/* <UseCases /> hidden until its pages ship */}
  {/* <Features /> hidden until its pages ship */}
  {/* <PublishTrackBeta /> hidden until its pages ship */}
</BaseLayout>
