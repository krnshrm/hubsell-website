---
// ============================= LEARNING NOTES =============================
// Dutch copy of src/pages/index.astro, serving the URL /nl/ .
// LOCALE PAGE PATTERN: see the full explanation at the top of
// src/pages/de/index.astro. In short: same components as the English page,
// import paths one level deeper, translated meta text; the components
// translate themselves because Astro.currentLocale is 'nl' under /nl/.
// ==========================================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { softwareApplicationSchema } from '../../data/seo';
import { getHome } from '../../data/home-i18n';
import Hero from '../../components/Hero.astro';
import CustomerLogos from '../../components/CustomerLogos.astro';
import VolumeVsPrecision from '../../components/VolumeVsPrecision.astro';
import Comparison from '../../components/Comparison.astro';
import FragmentedStack from '../../components/FragmentedStack.astro';
import ZeroDaySourcing from '../../components/ZeroDaySourcing.astro';
import RatingsStrip from '../../components/RatingsStrip.astro';
import PipelineSteps from '../../components/PipelineSteps.astro';
import Pricing from '../../components/Pricing.astro';
// import UseCases from '../../components/UseCases.astro';  // hidden until its pages ship
// import Features from '../../components/Features.astro';  // hidden until its pages ship
import Testimonials from '../../components/Testimonials.astro';
// import PublishTrackBeta from '../../components/PublishTrackBeta.astro';  // hidden until its pages ship
import Faq from '../../components/Faq.astro';
import Insights from '../../components/Insights.astro';

// Dutch homepage. Same section rhythm as the English home; each section reads
// Astro.currentLocale (='nl' from the /nl/ path) and renders its Dutch copy via
// src/data/home-i18n.ts. The pricing table and animated product embeds pull
// their Dutch labels from src/data/embed-i18n.ts.
//
// LEARNING: title/description name all three channels (e-mail, LinkedIn,
// telefoon) because the page body does too — see the matching note in
// src/pages/index.astro. The FAQPage schema is built from the same Dutch
// `faqs` the Faq component renders on this route, so it always matches what
// a visitor actually sees.
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: getHome('nl').faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.answer) },
  })),
};
---
<BaseLayout title="hubsell | Live verzamelde data, e-mail-, LinkedIn- en telefoon-outreach, één platform" description="hubsell verzamelt B2B-contacten live, draait e-mail, LinkedIn en telefoon in één flow en synchroniseert uw CRM automatisch. Eén platform dat uw outbound-stack vervangt.">
  <JsonLd slot="head" schema={[softwareApplicationSchema, faqSchema]} />
  {/*  1 */}<Hero />
  {/*  2 */}<CustomerLogos />
  {/*  3 */}<VolumeVsPrecision />
  {/*  4 */}<Comparison />
  {/*  5 */}<FragmentedStack />
  {/*  6 */}<ZeroDaySourcing />
  {/*  7 */}<RatingsStrip />
  {/*  8 */}<PipelineSteps />
  {/*  9 */}<Pricing />
  {/* 10 <UseCases /> hidden until its pages ship */}
  {/* 11 <Features /> hidden until its pages ship */}
  {/* 12 */}<Testimonials />
  {/* 13 <PublishTrackBeta /> hidden until its pages ship */}
  {/* 14 */}<Faq />
  {/* 15 */}<Insights />
</BaseLayout>
