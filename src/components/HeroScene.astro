---
// Homepage hero: copy, then the working flow demo directly under it. The
// dune illustration was removed on 2026-10-13; the demo is the visual.
import FlowDemo from './FlowDemo.astro';
import CtaGroup from './CtaGroup.astro';
import AvatarStack from './AvatarStack.astro';
import { getHome } from '../data/home-i18n';
import { asLocale } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
const { s } = getHome(L);

// German is third person with a lowercase "hubsell": the sentences after the
// first drop the subject, which stays clear because the first names hubsell.
// Dutch is formal (u).
const COPY = {
  en: {
    kw: 'Outbound sales platform',
    h1a: ['Generate ', 'more pipeline', ','], h1b: ['while targeting ', 'fewer prospects', '.'],
    sub: 'hubsell is an outbound sales platform that books the same meetings from 50 times fewer people. Start from a LinkedIn post, an event, a search or your own list. hubsell qualifies them, finds verified contact data and runs LinkedIn, email and call tasks in one flow that writes back to your CRM.',
    see: 'See demo below',
  },
  de: {
    kw: 'Outbound-Vertriebsplattform',
    h1a: ['', 'Mehr Pipeline', ' erzeugen,'], h1b: ['mit ', 'weniger Kontakten', '.'],
    sub: 'hubsell ist eine Outbound-Vertriebsplattform, die dieselben Termine mit 50-mal weniger Kontakten bucht. Startet mit einem LinkedIn-Beitrag, einem Event, einer Suche oder einer eigenen Liste. Qualifiziert die Kontakte, findet verifizierte Kontaktdaten und steuert LinkedIn, E-Mail und Anrufaufgaben in einem Flow, der alles ins CRM zurückschreibt.',
    see: 'Demo unten ansehen',
  },
  nl: {
    kw: 'Outbound salesplatform',
    h1a: ['', 'Meer pipeline', ' genereren,'], h1b: ['met ', 'minder prospects', '.'],
    sub: 'hubsell is een outbound salesplatform dat dezelfde afspraken boekt met 50 keer minder prospects. Begin met een LinkedIn-post, een event, een zoekopdracht of uw eigen lijst. hubsell kwalificeert ze, vindt geverifieerde contactgegevens en voert LinkedIn, e-mail en beltaken uit in één flow die alles terugschrijft naar uw CRM.',
    see: 'Bekijk de demo hieronder',
  },
};
const T = COPY[L as keyof typeof COPY] ?? COPY.en;

---
<section class="hs" aria-labelledby="hs-title">
  <div class="wrap hs__copy">
    <h1 id="hs-title" class="heading_hero hs__title"><span class="eyebrow hs__kw">{T.kw}</span>{T.h1a[0]}<span class="accent">{T.h1a[1]}</span>{T.h1a[2]}{" "}{T.h1b[0]}<span class="accent">{T.h1b[1]}</span>{T.h1b[2]}</h1>
    <div class="hs__side">
      <p class="hs__sub">{T.sub}</p>
      {/* The section class is "hs", which track.ts does not recognise as a
          hero, so the group says where it is. */}
      <div class="hs__cta">
        <CtaGroup location="hero" third={{ label: T.see, href: '#demo', icon: 'down' }} />
      </div>
      <div class="hs__proof">
        <AvatarStack size={32} />
        <ul>
          {s.hero.stats.map((st) => (
            <li><b>{st.value}</b> {st.label} <i>{st.company}</i></li>
          ))}
        </ul>
      </div>
    </div>
  </div>


  <div class="hs__stage" id="demo">
    <FlowDemo embed />
  </div>
</section>

<style>
  /* Same flat tint as the logos section below, and no clipping, so the demo
     window's shadow falls softly onto the next section instead of being cut
     off at the hero's edge. */
  .hs{
    --sky1:var(--sec-paper);
    --ink:var(--hs-foreground); --ink-2:var(--hs-muted-foreground); --accent:var(--hl-ink);
    position:relative; z-index:1;
    padding-top:clamp(40px,6vw,76px);
    color:var(--ink);
    background:var(--sec-paper);
  }

  /* ---- copy ---- */
  .hs__copy{
    position:relative; z-index:2;
    display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);
    gap:clamp(24px,4vw,64px); align-items:start;
  }
  /* The category name sits inside the H1 for search, styled as a small
     label so the slogan still reads as the headline. */
  .hs__kw{ display:block; margin-bottom:clamp(10px,1.2vw,16px) }
  /* Lexend's cap height sits lower in its line box than the body text's, so
     the side column drops a little to line its first line up with the H1. */
  .hs__side{ padding-top:clamp(6px,.9vw,14px) }
  .hs__sub{ margin:0; font-size:clamp(16px,1.3vw,18px); line-height:1.55; color:var(--ink-2); max-width:34rem }
  .hs__cta{ margin-top:26px }
  .hs__proof{ display:flex; align-items:center; gap:14px; margin-top:26px; flex-wrap:wrap }
  .hs__proof ul{ list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:4px 16px; font-size:13px; color:var(--ink-2) }
  .hs__proof b{ font:700 14px/1 var(--font-head); color:var(--accent) }
  .hs__proof i{ font-style:normal; font-weight:600; color:var(--ink) }

  /* ---- demo window ---- */
  .hs__stage{
    position:relative; z-index:3;
    margin-top:clamp(40px,5vw,64px);
    padding-bottom:clamp(16px,2vw,32px);
  }
  .hs__stage :global(.fd__app){ box-shadow:0 40px 80px -40px rgba(25,35,65,.5), 0 2px 8px rgba(25,35,65,.08) }


  @media (max-width:900px){
    .hs__copy{ grid-template-columns:1fr; align-items:start }
  }
</style>
