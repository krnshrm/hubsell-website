---
import CtaGroup from './CtaGroup.astro';
// Shared body template for the three /platform capability pages. The route file
// owns BaseLayout, title/description, and breadcrumb JSON-LD; this renders the
// sections. Background rhythm: paper, sand, navy, paper, sand (FAQ), espresso.
import { localizedHref } from '../i18n/utils';
import { SIGNUP_URL } from '../data/site';
import { getHome } from '../data/home-i18n';
import { getPlatformQuote } from '../data/platform-i18n';
import type { PlatformDetailData } from '../data/platform-content';
import type { Locale } from '../i18n/ui';
import SocialProspecting from './SocialProspecting.astro';
import MultichannelFlow from './MultichannelFlow.astro';
import CrmSyncTracker from './CrmSyncTracker.astro';
import ZeroDayTimeline from './ZeroDayTimeline.astro';
import LiveDataSteps from './LiveDataSteps.astro';
import MultichannelSteps from './MultichannelSteps.astro';
import CrmSyncSteps from './CrmSyncSteps.astro';
import PlatformDeliverabilityViz from './PlatformDeliverabilityViz.astro';
import PlatformPersonalizationViz from './PlatformPersonalizationViz.astro';
import PlatformEnrichmentViz from './PlatformEnrichmentViz.astro';
import PlatformStoryCard from './PlatformStoryCard.astro';
import PlatformFaqPicks from './PlatformFaqPicks.astro';
import PlatformHeroSlice from './PlatformHeroSlice.astro';
import PlatformCompare from './PlatformCompare.astro';
import HeroPipelineFlow from './HeroPipelineFlow.astro';
import PlatformStages from './PlatformStages.astro';
import SectionHead from './SectionHead.astro';

interface Props { L: Locale; data: PlatformDetailData }
const { L, data: d } = Astro.props;
const { s } = getHome(L);

const EMBEDS: Record<string, any> = {
  '05-sp-widget': SocialProspecting,
  '06-multichannel-flow': MultichannelFlow,
  '07-crm-sync-tracker': CrmSyncTracker,
  '08-deliverability': PlatformDeliverabilityViz,
  '09-personalization': PlatformPersonalizationViz,
  '10-enrichment': PlatformEnrichmentViz,
};
const DIMS: Record<string, { w: number; h: number }> = {
  '05-sp-widget': { w: 630, h: 500 },
  '06-multichannel-flow': { w: 740, h: 520 },
  '07-crm-sync-tracker': { w: 710, h: 480 },
  '08-deliverability': { w: 560, h: 470 },
  '09-personalization': { w: 560, h: 470 },
  '10-enrichment': { w: 560, h: 470 },
};
const Embed = EMBEDS[d.row.embed];
const dim = DIMS[d.row.embed] ?? { w: 700, h: 500 };
// Stepped detail visuals: a walked, multi-row expansion of the summary embed.
// Keyed by the same embed id; only the pages that have one render the section.
const STEP_EMBEDS: Record<string, any> = {
  '05-sp-widget': LiveDataSteps,
  '06-multichannel-flow': MultichannelSteps,
  '07-crm-sync-tracker': CrmSyncSteps,
};
const StepEmbed = STEP_EMBEDS[d.row.embed];
const quote = getPlatformQuote(L, d.quoteSlug);
// Pages with a before-and-after table use the 2026-10-15 layout.
const v2 = Boolean(d.compare);
const h = d.heads;
const SIG_ICON: Record<string, string> = {
  post: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  event: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>',
  followers: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  jobs: '<path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/>',
  hiring: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  email: '<path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="m16 19 2 2 4-4"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  profile: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  visit: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
  invite: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  inmail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  call: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/>',
  branch: '<circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><circle cx="6" cy="18" r="3"/><path d="M6 9v6"/><path d="M18 15V9a3 3 0 0 0-3-3H9"/>',
  wait: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  company: '<rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>',
  map: '<path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>',
  ban: '<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>',
  clean: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
};
const STAGE_OF: Record<string, string[]> = {
  '/platform/live-data': ['source', 'qualify'],
  '/platform/enrichment': ['enrich'],
  '/platform/multichannel-outreach': ['outreach'],
  '/platform/crm-sync': ['crm'],
  '/platform/deliverability': ['outreach'],
  '/platform/personalization': ['outreach'],
};
import Avatar from './Avatar.astro';
---
<!-- 1 · Hero (paper) -->
<section class="sec sec--paper" aria-labelledby="pf-title">
  <div class="wrap">
    <div class:list={['pf-hero', d.heroSlice && 'has-slice']}>
      <div class="sec-head" style="margin-bottom:0">
        <p class="eyebrow">{d.eyebrow}</p>
        <h1 id="pf-title" class="heading_hero" style="margin-top:10px">{d.h1Pre}<span class="accent">{d.h1Accent}</span>{d.h1Post}</h1>
        <p class="subheading" style="margin-top:16px;max-width:62ch">{d.sub}</p>
        <div style="margin:28px 0 0"><CtaGroup location="hero" /></div>
      </div>
      {d.heroSlice && <div class="pf-hero__slice">{d.heroSlice === 'deliverability' ? <HeroPipelineFlow variant="deliverability" /> : <PlatformHeroSlice kind={d.heroSlice} />}</div>}
    </div>
    {v2 && STAGE_OF[d.path] && <div class="pf-stages"><PlatformStages current={STAGE_OF[d.path]} /></div>}
    {!v2 && d.heroTimeline && (
      <div style="margin-top:clamp(36px,5vw,60px)">
        <ZeroDayTimeline />
      </div>
    )}
  </div>
</section>

{d.compare && <PlatformCompare id="pf-compare" c={d.compare} />}

<!-- 2a · New layout: signals summary, heading left and widget right (sand),
     then each signal explained on its own (paper). -->
{v2 && d.signals && h && (
  <section class="sec sec--sand" aria-labelledby="pf-signals" style="--vw:560">
    <div class="wrap" style="max-width:1200px">
      <div class="prow">
        <div class="prow__head">
          <SectionHead id="pf-signals" {...h.signals} />
          <div class="prow__points" style="margin-top:0">
            {d.row.points.map((p) => <p class="paragraph" style="opacity:.84;margin:0">{p}</p>)}
          </div>
        </div>
        <div class="prow__media">
          <div class="viz" style={`--w:${dim.w};--h:${dim.h}`}>
            <div class="viz__inner">{Embed && <Embed />}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
)}
{v2 && d.signals && h && (
  <section class="sec sec--paper" aria-labelledby="pf-explained">
    <div class="wrap">
      <SectionHead id="pf-explained" {...h.explained} sub={d.signals.sub} />
      <ol class="psig">
        {d.signals.items.map((it) => (
          <li class="psig__item" id={`signal-${it.id}`}>
            <span class="psig__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={SIG_ICON[it.id] ?? SIG_ICON.search} />
            </span>
            <div class="psig__txt">
              <h3 class="psig__t">{it.title}</h3>
              <p class="psig__b">{it.body}</p>
              {it.start && <p class="psig__s"><b>{d.signals!.startLabel}:</b> {it.start}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<!-- 2 · Feature row with the product embed (sand) -->
{!(v2 && d.signals) && <section class="sec sec--sand" aria-label={d.row.titlePre + d.row.titleAccent + d.row.titlePost} style="--vw:640">
  <div class="wrap" style="max-width:1200px">
    <div class="prow">
      <div class="prow__head">
        <h2 class="heading_secondary">{d.row.titlePre}<span class="accent">{d.row.titleAccent}</span>{d.row.titlePost}</h2>
        <div class="prow__points">
          {d.row.points.map((p) => <p class="paragraph" style="opacity:.84;margin:0">{p}</p>)}
        </div>
      </div>
      <div class="prow__media">
        <div class="viz" style={`--w:${dim.w};--h:${dim.h}`}>
          <div class="viz__inner">{Embed && <Embed />}</div>
        </div>
      </div>
    </div>
  </div>
</section>}

<!-- 2b · Stepped detail walkthrough (paper) -->
{StepEmbed && (
  <section class={`sec ${v2 ? 'sec--sand' : 'sec--paper'}`} aria-label={d.row.titlePre + d.row.titleAccent + d.row.titlePost}>
    <div class="wrap">
      {h ? <SectionHead {...h.steps} /> : (
        <div class="sec-head">
          <p class="eyebrow">{d.row.stepEyebrow ?? d.eyebrow}</p>
          <h2 class="heading_primary" style="margin-top:8px">{d.row.stepTitle ?? (d.row.titlePre + d.row.titleAccent + d.row.titlePost)}</h2>
        </div>
      )}
      <StepEmbed />
    </div>
  </section>
)}

{v2 && !StepEmbed && d.howSteps && h && (
  <section class="sec sec--sand" aria-labelledby="pf-steps">
    <div class="wrap">
      <SectionHead id="pf-steps" {...h.steps} />
      <ol class="phow" style={`--n:${d.howSteps.items.length > 4 ? 3 : d.howSteps.items.length}`}>
        {d.howSteps.items.map((st, i) => (
          <li class="phow__item">
            <span class="phow__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="phow__t">{st.title}</h3>
            <p class="phow__b">{st.body}</p>
          </li>
        ))}
      </ol>
      {d.howSteps.note && <p class="phow__note">{d.howSteps.note}</p>}
    </div>
  </section>
)}

<!-- 3 · Value grid (navy), replaced by the before-and-after table in the new layout -->
{!v2 && <section class="sec sec--navy" aria-label={d.gridTitlePre + d.gridTitleAccent + d.gridTitlePost}>
  <div class="wrap">
    <div class="sec-head">
      <h2 class="heading_primary">{d.gridTitlePre}<span class="accent">{d.gridTitleAccent}</span>{d.gridTitlePost}</h2>
    </div>
    <div class="pgrid">
      {d.blocks.map((b) => (
        <div class="card">
          <h3 class="heading_small">{b.title}</h3>
          <p class="paragraph_small" style="margin-top:10px">{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>}

{d.extra && (
  <section class={`sec ${v2 ? 'sec--paper' : 'sec--sand'}`} aria-labelledby="pf-extra">
    <div class="wrap"><div class="pf-extra">
      {h ? <SectionHead id="pf-extra" {...h.extra} /> : <h2 id="pf-extra" class="heading_primary">{d.extra.title}</h2>}
      {d.extra.paras.map((p) => <p class="paragraph">{p}</p>)}
      {d.extra.links && (
        <ul class="pf-extra__links">
          {d.extra.links.map((l) => <li><a class="link" href={localizedHref(L, l.href)}>{l.label} &rarr;</a></li>)}
        </ul>
      )}
    </div></div>
  </section>
)}

<!-- 4 · Proof: customer story + quote (paper) -->
<section class={`sec ${v2 ? 'sec--sand' : 'sec--paper'}`} aria-label={d.proofTitle}>
  <div class="wrap">
    {h ? <SectionHead {...h.proof} /> : (
      <div class="sec-head">
        <p class="eyebrow">{d.proofEyebrow}</p>
        <h2 class="heading_primary" style="margin-top:8px">{d.proofTitle}</h2>
      </div>
    )}
    <div class="pproof">
      <PlatformStoryCard L={L} slug={d.storySlug} label={d.storyLabel} />
      {quote && (
        <figure class="card pquote">
          <blockquote class="quote" style="margin:0">&ldquo;{quote.quote}&rdquo;</blockquote>
          <figcaption class="pq-by">
            <Avatar src={quote.photo} name={quote.name} size={48} />
            <span class="pq-by__meta"><b>{quote.name}</b><span>{[quote.title, quote.company].filter(Boolean).join(' \u00b7 ')}</span></span>
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<!-- 5 · FAQ picks (sand); after the closing CTA in the new layout -->
{!v2 && <PlatformFaqPicks L={L} eyebrow={d.faqEyebrow} title={d.faqTitle} slugs={d.faqSlugs} items={d.faqs} seeAll={s.faqSec.seeAll} />}

<!-- 6 · Closing CTA (espresso) -->
<section class="sec sec--esp" aria-label={d.closing.titlePre + d.closing.titleAccent + d.closing.titlePost}>
  <div class="wrap" style="text-align:center">
    {h ? <SectionHead {...h.closing} align="center" sub={d.closing.sub} /> : (
      <Fragment>
        <h2 class="heading_primary">{d.closing.titlePre}<span class="accent">{d.closing.titleAccent}</span>{d.closing.titlePost}</h2>
        <p class="subheading" style="margin:16px auto 0;max-width:56ch">{d.closing.sub}</p>
      </Fragment>
    )}
    <div style="margin:30px 0 0"><CtaGroup align="center" /></div>
  </div>
</section>

{v2 && <PlatformFaqPicks L={L} tone="paper" eyebrow={h ? h.faq.eyebrow : d.faqEyebrow} title={d.faqTitle} titleParts={h ? [h.faq.pre, h.faq.accent, h.faq.post] : undefined} slugs={d.faqSlugs} items={d.faqs} seeAll={s.faqSec.seeAll} />}

<style>
  .prow{ display:flex; flex-direction:column; gap:24px }
  .prow__head{ display:flex; flex-direction:column }
  .prow__points{ display:flex; flex-direction:column; gap:12px; margin-top:20px }
  .viz{ width:100% }

  .pgrid{ display:grid; grid-template-columns:1fr; gap:20px }
  .pproof{ display:grid; grid-template-columns:1fr; gap:20px; align-items:stretch }
  .pquote{ display:flex; flex-direction:column; justify-content:center }

  @media (min-width:760px){
    .pgrid{ grid-template-columns:1fr 1fr }
    .pproof{ grid-template-columns:1fr 1fr }
  }

  @media (min-width:1120px){
    .prow{ flex-direction:row; align-items:center; gap:clamp(40px,4vw,72px) }
    .prow__head{ flex:1 1 0; min-width:0 }
    .prow__media{ flex:0 0 calc(var(--vw) * 1px); display:flex; justify-content:center }
    .viz{ position:relative; width:calc(var(--vw) * 1px); aspect-ratio:var(--w) / var(--h) }
    .viz__inner{ position:absolute; top:0; left:0; width:calc(var(--w) * 1px); height:calc(var(--h) * 1px); transform-origin:top left; transform:scale(calc(var(--vw) / var(--w))) }
    .viz__inner > :global(.sp-wrap),
    .viz__inner > :global(.hubsell-tree-embed),
    .viz__inner > :global(.hubsell-sync-embed){ padding:0 }
  }
  .pf-extra{ max-width:760px }
  .pf-extra .paragraph{ margin-top:16px }
  .pf-extra__links{ list-style:none; padding:0; margin:22px 0 0; display:flex; flex-direction:column; gap:8px }
  /* Hero with a flow slice: copy left, slice right; stacked below 960px. */
  .pf-hero.has-slice{ display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); gap:clamp(32px,5vw,72px); align-items:center }
  .pf-hero > *{ min-width:0 }
  .pf-hero__slice{ width:100%; max-width:420px; justify-self:end }
  @media (max-width:960px){
    .pf-hero.has-slice{ grid-template-columns:1fr }
    .pf-hero__slice{ justify-self:start; max-width:400px }
  }
  .pf-stages{ margin-top:clamp(36px,5vw,56px) }

  .prow__head :global(.sec-head){ margin-bottom:20px }
  /* Signals explained: a two-column list with hairlines, no cards. */
  .psig{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(32px,5vw,72px) }
  .psig__item{ display:flex; gap:18px; padding:28px 0; border-top:1px solid var(--sec-bd); scroll-margin-top:96px }
  .psig__ico{ flex:none; display:grid; place-items:center; width:42px; height:42px; border-radius:10px; background:var(--hl-soft); color:var(--hl-ink) }
  .psig__ico svg{ width:20px; height:20px }
  .psig__t{ margin:0; font:600 1.125rem/1.3 var(--font-head); color:var(--sec-tx) }
  .psig__b{ margin:8px 0 0; font:400 .9375rem/1.6 var(--font-body); color:var(--sec-tx); opacity:.8 }
  .psig__s{ margin:10px 0 0; font:400 .875rem/1.5 var(--font-body); color:var(--sec-tx) }
  .psig__s b{ font-weight:600 }
  @media (max-width:760px){ .psig{ grid-template-columns:1fr } }
  /* Numbered steps for pages without a stepped widget. */
  .phow{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(var(--n,5),minmax(0,1fr)); gap:14px; counter-reset:none }
  .phow__item{ position:relative; padding:20px 18px; border:1px solid var(--sec-bd); border-radius:var(--radius-lg); background:var(--sec-card) }
  .phow__n{ font:600 13px/1 var(--font-body); color:var(--hl-ink); letter-spacing:.04em }
  .phow__t{ margin:10px 0 0; font:600 1rem/1.3 var(--font-head); color:var(--sec-tx) }
  .phow__b{ margin:6px 0 0; font:400 .875rem/1.55 var(--font-body); color:var(--sec-tx); opacity:.8 }
  .phow__note{ margin:22px 0 0; max-width:70ch; font:500 .9375rem/1.6 var(--font-body); color:var(--sec-tx) }
  @media (max-width:960px){ .phow{ grid-template-columns:repeat(2,minmax(0,1fr)) } }
  @media (max-width:560px){ .phow{ grid-template-columns:1fr } }

  .pq-by{ display:flex; align-items:center; gap:12px; margin-top:20px }
  .pq-by__meta{ display:flex; flex-direction:column; gap:2px; font:400 13.5px/1.35 var(--font-body); color:var(--sec-tx) }
  .pq-by__meta span{ opacity:.7 }
</style>
