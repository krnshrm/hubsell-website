---
// Stepped detail visual for /platform/crm-sync: (1) contacts are pushed by hand
// or by rule, (2) matched to the existing record and mapped to fields, (3) activity
// is logged as it happens. The sync is one-way into the CRM today, so nothing here
// may suggest data flowing back. CRM brand names stay English on purpose.
import { et } from '../data/embed-i18n';
import { asLocale } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
---
<div class="crs" data-crs>
  <div class="crs-step">
    <div class="crs-text">
      <span class="crs-num">01</span>
      <h3 class="heading_small">{et(L, 'Choose what to push')}</h3>
      <p class="paragraph_small crs-cap">{et(L, 'Push contacts by hand, or set conditions that push them for you.')}</p>
    </div>
    <div class="crs-viz">
      <div class="crs-rules card">
        <div class="crs-rule"><span class="crs-tg"></span>{et(L, 'Push by hand')}</div>
        <div class="crs-rule is-on"><span class="crs-tg"></span>{et(L, 'Push automatically when')}</div>
        <div class="crs-chips"><span>{et(L, 'Replied')}</span><span>{et(L, 'Invite accepted')}</span></div>
      </div>
    </div>
  </div>

  <div class="crs-step">
    <div class="crs-text">
      <span class="crs-num">02</span>
      <h3 class="heading_small">{et(L, 'Matched and mapped')}</h3>
      <p class="paragraph_small crs-cap">{et(L, 'Each contact is matched to its existing record, and your field mapping decides where every value goes.')}</p>
    </div>
    <div class="crs-viz">
      <div class="crs-map">
        <div class="crs-src">{et(L, 'Contact')}</div>
        <svg class="crs-arrow" viewBox="0 0 60 24" aria-hidden="true"><path class="crs-flow" d="M0 12 H50"/><path d="M46 6 L56 12 L46 18" fill="none"/></svg>
        <div class="crs-fields">
          <span>{et(L, 'Existing record found')}</span><span>{et(L, 'Company')}</span><span>{et(L, 'Job title')}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="crs-step">
    <div class="crs-text">
      <span class="crs-num">03</span>
      <h3 class="heading_small">{et(L, 'Logged as it happens')}</h3>
      <p class="paragraph_small crs-cap">{et(L, 'Email, LinkedIn and call activity lands on the record in Salesforce, HubSpot or Pipedrive in real time.')}</p>
    </div>
    <div class="crs-viz">
      <div class="crs-feed card">
        <div class="crs-frow"><span class="crs-fdot"></span>{et(L, 'Email sent')}<span class="crs-ftime">09:04</span></div>
        <div class="crs-frow"><span class="crs-fdot"></span>{et(L, 'Invite accepted')}<span class="crs-ftime">09:40</span></div>
        <div class="crs-frow"><span class="crs-fdot"></span>{et(L, 'Reply received')}<span class="crs-ftime">10:20</span></div>
        <div class="crs-frow"><span class="crs-fdot"></span>{et(L, 'Call task created')}<span class="crs-ftime">10:21</span></div>
      </div>
    </div>
  </div>
</div>

<style>
  .crs{ display:flex; flex-direction:column; gap:14px }
  .crs-step{ display:grid; grid-template-columns:1fr; gap:16px; align-items:center;
    border:1px solid var(--sec-bd); border-radius:16px; padding:22px; background:color-mix(in srgb, var(--sec-tx) 3%, transparent) }
  .crs-num{ font-family:var(--font-head); font-weight:600; font-size:.95rem; color:var(--accent-on) }
  .crs-text .heading_small{ margin:6px 0 0 }
  .crs-cap{ margin:8px 0 0; max-width:44ch }
  .crs-viz{ display:flex; align-items:center; justify-content:center; min-height:120px }

  .crs-feed{ width:100%; max-width:320px; padding:14px 18px }
  .crs-frow{ display:flex; align-items:center; gap:10px; padding:9px 0; border-top:1px solid var(--sec-bd); font:500 13.5px/1 var(--font-body); color:var(--sec-tx) }
  .crs-frow:first-child{ border-top:0 }
  .crs-fdot{ width:8px; height:8px; border-radius:50%; background:#289B9B; flex:none; box-shadow:0 0 0 3px rgba(40,155,155,.18) }
  .crs-ftime{ margin-left:auto; font:500 12px/1 var(--font-body); color:var(--sec-tx); opacity:.55 }

  .crs-map{ display:flex; align-items:center; gap:12px; width:100%; justify-content:center; flex-wrap:wrap }
  .crs-src{ background:#FFFFFF; color:#192341; border:1px solid #E5E7EB; border-radius:10px; padding:10px 16px; font:500 13px/1 var(--font-body); box-shadow:0 4px 12px rgba(0,0,0,.10) }
  .crs-fields{ display:flex; flex-direction:column; gap:6px }
  .crs-fields span{ background:#FFFFFF; color:#23757E; border:1px solid #289B9B; border-radius:8px; padding:7px 12px; font:600 12px/1 var(--font-body) }
  .crs-arrow{ width:60px; height:24px; color:#289B9B; flex:none }
  .crs-arrow path{ stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; fill:none }

  .crs-rules{ width:100%; max-width:320px; padding:14px 18px; display:flex; flex-direction:column; gap:10px }
  .crs-rule{ display:flex; align-items:center; gap:10px; font:500 13.5px/1.2 var(--font-body); color:var(--sec-tx); opacity:.6 }
  .crs-rule.is-on{ opacity:1 }
  .crs-tg{ flex:none; width:28px; height:16px; border-radius:999px; background:var(--sec-bd); position:relative }
  .crs-tg::after{ content:''; position:absolute; top:2px; left:2px; width:12px; height:12px; border-radius:50%; background:#FFFFFF; box-shadow:0 1px 2px rgba(0,0,0,.2) }
  .crs-rule.is-on .crs-tg{ background:#289B9B }
  .crs-rule.is-on .crs-tg::after{ left:14px }
  .crs-chips{ display:flex; flex-wrap:wrap; gap:6px; padding-left:38px }
  .crs-chips span{ background:#FFFFFF; color:#23757E; border:1px solid #289B9B; border-radius:8px; padding:6px 10px; font:600 12px/1 var(--font-body) }

  .crs-flow{ stroke:#289B9B; stroke-width:2; fill:none }

  @media (min-width:760px){
    .crs-step{ grid-template-columns:0.9fr 1.1fr; gap:28px; padding:26px 30px }
  }

  :global(html.has-anim) [data-crs] .crs-step{ opacity:0; transform:translateY(16px) }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initCrmSyncSteps() {
    const wrap = document.querySelector('[data-crs]') as HTMLElement | null;
    if (!wrap || wrap.dataset.init) return;
    if (!document.documentElement.classList.contains('has-anim')) return;
    wrap.dataset.init = '1';
    gsap.registerPlugin(ScrollTrigger);

    const steps = Array.from(wrap.querySelectorAll('.crs-step')) as HTMLElement[];
    steps.forEach((step) => {
      gsap.timeline({ scrollTrigger: { trigger: step, start: 'top 82%', toggleActions: 'play none none none' } })
        .fromTo(step, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', clearProps: 'transform' });
    });
  }

  initCrmSyncSteps();
  document.addEventListener('astro:page-load', initCrmSyncSteps);
</script>
