---
// ============================= LEARNING NOTES =============================
// PAGE BODY component: a thin route file under src/pages/ owns the layout,
// meta and structured data, and hands the actual rendering to this file.
// The split exists so the de/ and nl/ route copies reuse this body and it
// translates itself. Annotated exemplars for the pattern:
// src/components/GlossaryIndex.astro and src/components/SolutionDetail.astro.
// No props: it reads Astro.currentLocale and fetches its own strings
// from the shared data layer.
// The <style> block is scoped to this component (Astro hashes the
// selectors), styled with the design tokens from src/styles/global.css.
// ==========================================================================
// Book-a-call page body. Single source rendered by both /book-a-call (English)
// and /de/book-a-call (German); self-localizes from Astro.currentLocale.
import BookCallForm from './BookCallForm.astro';
import { CALL_HOSTS } from '../data/site';
import { asLocale } from '../i18n/utils';
import { getBookCall } from '../i18n/pages';

const L = asLocale(Astro.currentLocale);
const c = getBookCall(L);
---
<section class="sec sec--paper bc-hero">
  <div class="wrap">
    <p class="eyebrow is-accent">{c.eyebrow}</p>
    <h1 class="bc-title">{c.title}</h1>
    <p class="bc-sub subheading">{c.sub}</p>
  </div>
</section>

<section class="sec sec--sand bc-body">
  <div class="wrap">
    <div class="bc-grid">
      <div class="bc-copy">
        <h2 class="heading_tertiary">{c.coversHeading}</h2>
        <ul class="bc-list">
          {c.covers.map((item) => (<li>{item}</li>))}
        </ul>
        <p class="bc-note">{c.note}</p>

        {/* Who you will actually be talking to. Renders only once CALL_HOST.photo
            is set in src/data/site.ts, so an empty config changes nothing. */}
        {CALL_HOSTS.filter((h) => h.photo).length > 0 && (
          <div class="bc-hosts">
            <p class="bc-hosts__heading">{c.teamHeading}</p>
            <div class="bc-hosts__row">
              {/* Photos only. The names still live in alt and title, so a
                  screen reader and a hover both name the person. */}
              {CALL_HOSTS.filter((h) => h.photo).map((h) => (
                <img
                  class="bc-host__face"
                  src={h.photo}
                  alt={h.title ? `${h.name}, ${h.title}` : h.name}
                  title={h.title ? `${h.name} — ${h.title}` : h.name}
                  width="64" height="64" loading="lazy" decoding="async"
                />
              ))}
            </div>
          </div>
        )}
      </div>
      <div class="bc-formcard">
        <BookCallForm />
      </div>
    </div>
  </div>
</section>

<style>
  .bc-hosts{ margin-top:22px; padding-top:20px; border-top:1px solid var(--sec-bd); }
  .bc-hosts__heading{ margin:0 0 12px; font-family:var(--font-head); font-weight:600; font-size:1rem; color:var(--sec-tx); }
  .bc-hosts__row{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .bc-host__face{ width:64px; height:64px; border-radius:50%; object-fit:cover; flex-shrink:0; background:color-mix(in srgb,var(--sec-tx) 10%,transparent); }
  .bc-hero { padding-bottom: clamp(24px,3vw,36px); }
  .bc-title { font-family:var(--font-head); font-weight:600; font-size:clamp(2rem,4.4vw,2.75rem); line-height:1.1; letter-spacing:-.02em; color:var(--sec-tx); margin:8px 0 0; }
  .bc-sub { margin-top:14px; max-width:60ch; }

  .bc-grid { display:grid; grid-template-columns:0.82fr 1.18fr; gap:clamp(28px,5vw,56px); align-items:start; }
  @media (max-width:820px){ .bc-grid{ grid-template-columns:1fr; } }

  .bc-copy .heading_tertiary { color:var(--sec-tx); margin-bottom:16px; }
  .bc-list { list-style:none; margin:0 0 22px; padding:0; display:flex; flex-direction:column; gap:12px; }
  .bc-list li { position:relative; padding-left:24px; font-family:var(--font-body); font-size:1.0625rem; line-height:1.5; color:var(--sec-tx); }
  .bc-list li::before { content:""; position:absolute; left:2px; top:.55em; width:8px; height:8px; border-radius:50%; background:var(--accent-on); }
  .bc-note { font-family:var(--font-body); font-size:15px; line-height:1.6; color:var(--sec-tx); opacity:.78; margin:0; max-width:46ch; }

  .bc-formcard { background:var(--sec-card); border:1px solid var(--sec-bd); border-radius:var(--radius-lg); padding:clamp(22px,3vw,30px); }
</style>
