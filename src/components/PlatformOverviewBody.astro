---
// Body of the /platform overview. Same section pattern as the platform detail
// pages (keyword eyebrow and two-colour H2 on every section), so the overview reads
// as the index of those pages. Each stage row reuses that page's hero slice.
// Background rhythm: paper, navy, sand, paper, sand, paper, navy, paper.
import CtaGroup from './CtaGroup.astro';
import SectionHead from './SectionHead.astro';
import HeroPipelineFlow from './HeroPipelineFlow.astro';
import PlatformStages from './PlatformStages.astro';
import PlatformCompare from './PlatformCompare.astro';
import PlatformHeroSlice from './PlatformHeroSlice.astro';
import PlatformStoryCard from './PlatformStoryCard.astro';
import PlatformFaqPicks from './PlatformFaqPicks.astro';
import { localizedHref } from '../i18n/utils';
import { getHome } from '../data/home-i18n';
import { getPlatformQuote } from '../data/platform-i18n';
import type { PlatformOverviewData } from '../data/platform-content';
import type { Locale } from '../i18n/ui';

interface Props { L: Locale; data: PlatformOverviewData }
const { L, data: d } = Astro.props;
const { s } = getHome(L);
const h = d.heads;
const quote = getPlatformQuote(L, d.quoteSlug);
---
<section class="sec sec--paper" aria-labelledby="pov-title">
  <div class="wrap">
    <div class="pov-hero">
      <div class="sec-head" style="margin-bottom:0">
        <p class="eyebrow">{d.eyebrow}</p>
        <h1 id="pov-title" class="heading_hero" style="margin-top:10px">{d.h1Pre}<span class="accent">{d.h1Accent}</span>{d.h1Post}</h1>
        <p class="subheading" style="margin-top:16px;max-width:62ch">{d.sub}</p>
        <div style="margin:28px 0 0"><CtaGroup location="hero" /></div>
      </div>
      <div class="pov-hero__viz"><HeroPipelineFlow /></div>
    </div>
    <div class="pov-stagestrip"><PlatformStages current={['source', 'qualify', 'enrich', 'outreach', 'crm']} /></div>
  </div>
</section>

<PlatformCompare id="pov-compare" c={d.compare} />

<section class="sec sec--sand" aria-labelledby="pov-stages">
  <div class="wrap">
    <SectionHead id="pov-stages" {...h.stages} />
    <div class="pov-rows">
      {d.stages.map((st, i) => (
        <article class:list={['pov-row', i % 2 === 1 && 'is-flip']}>
          <div class="pov-row__text">
            <p class="eyebrow">{st.eyebrow}</p>
            <h3 class="heading_secondary" style="margin-top:8px">{st.title}</h3>
            <p class="paragraph" style="margin-top:14px;opacity:.84">{st.body}</p>
            <a class="link" href={localizedHref(L, st.href)} style="margin-top:18px;display:inline-block">{st.linkLabel} &rarr;</a>
          </div>
          <div class="pov-row__viz"><PlatformHeroSlice kind={st.slice} /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sec sec--paper" aria-labelledby="pov-also">
  <div class="wrap">
    <SectionHead id="pov-also" {...h.also} />
    <div class="pov-two">
      {d.also.map((a) => (
        <a class="card pov-card" href={localizedHref(L, a.href)}>
          <h3 class="heading_small">{a.title}</h3>
          <p class="paragraph_small" style="margin-top:10px">{a.body}</p>
          <span class="link" style="margin-top:auto;padding-top:18px;display:inline-block">{a.linkLabel} &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="sec sec--sand" aria-labelledby="pov-why">
  <div class="wrap">
    <SectionHead id="pov-why" {...h.why} />
    <ol class="pov-why">
      {d.why.map((w, i) => (
        <li>
          <span class="pov-why__n">{i + 1}</span>
          <h3 class="heading_small">{w.title}</h3>
          <p class="paragraph_small" style="margin-top:10px">{w.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="sec sec--paper" aria-labelledby="pov-proof">
  <div class="wrap">
    <SectionHead id="pov-proof" {...h.proof} sub={d.ratingsLine} />
    <div class="pov-two">
      <PlatformStoryCard L={L} slug={d.storySlug} label={d.storyLabel} />
      {quote && (
        <figure class="card pov-quote">
          <blockquote class="quote" style="margin:0">&ldquo;{quote.quote}&rdquo;</blockquote>
          <figcaption class="paragraph_small" style="margin-top:16px">
            <b>{quote.name}</b>{quote.title && `, ${quote.title}`}{quote.company && ` · ${quote.company}`}
          </figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<section class="sec sec--esp" aria-labelledby="pov-closing">
  <div class="wrap" style="text-align:center">
    <SectionHead id="pov-closing" {...h.closing} align="center" sub={d.closingSub} />
    <div style="margin:30px 0 0"><CtaGroup align="center" /></div>
  </div>
</section>

<PlatformFaqPicks L={L} tone="paper" eyebrow={h.faq.eyebrow} title={h.faq.pre + h.faq.accent + h.faq.post} titleParts={[h.faq.pre, h.faq.accent, h.faq.post]} slugs={[]} items={d.faqs} seeAll={s.faqSec.seeAll} />

<style>
  .pov-hero{ display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:clamp(32px,5vw,72px); align-items:center }
  .pov-hero > *{ min-width:0 }
  .pov-hero__viz{ display:flex; justify-content:center }
  .pov-stagestrip{ margin-top:clamp(36px,5vw,56px) }
  @media (max-width:960px){
    .pov-hero{ grid-template-columns:1fr }
    .pov-hero__viz{ justify-content:flex-start }
  }

  .pov-rows{ display:flex; flex-direction:column; gap:clamp(48px,7vw,96px) }
  .pov-row{ display:grid; grid-template-columns:1fr; gap:28px; align-items:center }
  .pov-row__viz{ width:100%; max-width:400px }
  @media (min-width:960px){
    .pov-row{ grid-template-columns:minmax(0,1fr) minmax(0,400px); gap:clamp(48px,6vw,96px) }
    .pov-row.is-flip{ grid-template-columns:minmax(0,400px) minmax(0,1fr) }
    .pov-row.is-flip .pov-row__viz{ order:-1 }
  }

  .pov-two{ display:grid; grid-template-columns:1fr; gap:20px; align-items:stretch }
  @media (min-width:760px){ .pov-two{ grid-template-columns:1fr 1fr } }
  .pov-card{ display:flex; flex-direction:column; text-decoration:none; color:inherit }
  .pov-quote{ display:flex; flex-direction:column; justify-content:center }

  .pov-why{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:28px }
  @media (min-width:860px){ .pov-why{ grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(28px,4vw,56px) } }
  .pov-why li{ border-top:1px solid var(--sec-bd); padding-top:22px }
  .pov-why__n{ display:block; font:600 15px/1 var(--font-head); color:var(--accent-on); margin-bottom:12px }
</style>
