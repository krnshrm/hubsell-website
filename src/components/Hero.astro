---
// Homepage hero — section 1, Sand.
// Decluttered: headline + subhead + two CTAs (sign-up first), a quiet ratings
// line, and the discreet "Ask AI" row. The pipeline flow sits to the right.
import HeroPipelineFlow from './HeroPipelineFlow.astro';
import AskAiWidget from './AskAiWidget.astro';
import AvatarStack from './AvatarStack.astro';
import { SIGNUP_URL } from '../data/site';
import { getHome } from '../data/home-i18n';
import { asLocale, localizedHref } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
const { s } = getHome(L);
---
<section id="hero" class="sec sec--sand hero">
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__copy reveal-stagger">
        <p class="eyebrow">{s.hero.eyebrow}</p>
        <h1 class="heading_hero">{s.hero.titlePre}<span class="accent">{s.hero.titleAccent}</span>{s.hero.titlePost}</h1>
        <p class="subheading hero__sub">{s.hero.sub}</p>

        <div class="hero__cta">
          <a class="button is-large" href={localizedHref(L, SIGNUP_URL)}>{s.hero.ctaPrimary}</a>
        </div>

        {/* Measured customer outcomes, each attributed to the customer it came
            from. Attribution is the point: three named companies read as
            evidence, three bare percentages read as a typical-results claim.
            The 4.6+ ratings line used to sit here and now lives only in the
            RatingsStrip section, so the claim is no longer made twice. */}
        <div class="hero__proof">
          <AvatarStack size={34} />
          <ul class="hero__stats">
            {s.hero.stats.map((st) => (
              <li>
                <b>{st.value}</b>
                <span>{st.label}</span>
                <i>{st.company}</i>
              </li>
            ))}
          </ul>
        </div>

        <div class="hero__askai"><AskAiWidget /></div>
      </div>

      <div class="hero__visual">
        <HeroPipelineFlow />
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero is the first section. The global .sec padding (up to 120px top+bottom)
     is what pushes the pipeline below the fold — the hero's own content fits.
     Trim it (top especially) so the whole hero clears a ~870px-tall viewport.
     Scoped .hero outranks the global .sec rule, so other sections are untouched. */
  .hero{padding-top:clamp(20px,3vw,32px); padding-bottom:clamp(36px,5vw,56px)}

  .hero__grid{
    display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);
    gap:clamp(32px,5vw,72px); align-items:center;
  }
  .hero__copy{max-width:34rem}
  .hero__copy .eyebrow{margin-bottom:20px; text-wrap:balance}
  .hero__copy .heading_hero{margin-bottom:22px}
  .hero__sub{margin-bottom:34px; max-width:31rem}

  .hero__cta{display:flex; flex-wrap:wrap; gap:14px; align-items:center}

  .hero__proof{display:flex; align-items:center; gap:18px; flex-wrap:wrap; margin:28px 0 0}
  .hero__stats{
    list-style:none; margin:0; padding:0;
    display:flex; flex-wrap:wrap; gap:14px 28px;
  }
  .hero__stats li{ display:flex; flex-direction:column; gap:2px; }
  .hero__stats b{
    font:700 22px/1 var(--font-head); color:var(--accent-on); letter-spacing:-.01em;
    font-variant-numeric:tabular-nums;
  }
  .hero__stats span{ font-size:13px; line-height:1.3; color:var(--sec-tx); opacity:.78 }
  .hero__stats i{
    font-style:normal; font-size:10.5px; letter-spacing:.07em; text-transform:uppercase;
    color:var(--sec-tx); opacity:.5;
  }
  @media (max-width:520px){
    .hero__stats{ gap:12px 20px }
    .hero__stats b{ font-size:19px }
  }

  .hero__askai{margin-top:40px}

  .hero__visual{display:flex; justify-content:center}

  @media (max-width:880px){
    .hero__grid{grid-template-columns:1fr; gap:32px}
    .hero__copy{max-width:none}
  }
</style>
