---
// Section 3 — Volume vs precision (Espresso). Two panels running the same funnel
// to the same 42 opportunities: one burns the entire addressable market to get
// there, the other burns 2% of it. A looping animation sweeps each dot field
// left to right while the contact counters climb, then the kicker lands.
//
// PERFORMANCE NOTE: the grid is 1,000 dots per panel. Drawing those as
// individual <rect> elements would put about 3,000 nodes and 150KB of raw HTML
// on the homepage. Instead the full field is ONE rect filled with an SVG
// <pattern>, so the browser tiles the dots itself. Only the 20 highlighted
// dots on the targeted side are real elements. Same picture, ~23 nodes.
import { getHome } from '../data/home-i18n';
import { asLocale } from '../i18n/utils';

const L = asLocale(Astro.currentLocale);
const { s } = getHome(L);
const c = s.vvp;

// ---- The model. Numbers that appear inside sentences live in the locale
// files alongside the sentence; only the derived kicker figures are computed.
const VOLUME_CONTACTS = 100000;
const PRECISION_CONTACTS = 2000;
const OPPORTUNITIES = 42;
const DOT_VALUE = 100;   // contacts represented by one dot
const COLS = 50;

// ---- Grid geometry. STEP is the tile, SIZE the dot inside it.
const STEP = 7;
const SIZE = 4;
const totalDots = Math.round(VOLUME_CONTACTS / DOT_VALUE);
const rows = Math.ceil(totalDots / COLS);
const pickedCount = Math.max(1, Math.round(PRECISION_CONTACTS / DOT_VALUE));
const vbWidth = COLS * STEP - (STEP - SIZE);
const vbHeight = rows * STEP - (STEP - SIZE);

// Deterministic scatter so the targeted dots read as chosen, not clustered.
// A fixed stride means the picture is identical on every build.
const picked: { x: number; y: number }[] = [];
for (let p = 0; p < pickedCount; p++) {
  const i = (p * 137 + 41) % totalDots;
  picked.push({ x: (i % COLS) * STEP, y: Math.floor(i / COLS) * STEP });
}

// Locale-aware number formatting: 100,000 in English, 100.000 in German and Dutch.
const NUM_LOCALE = L === 'de' ? 'de-DE' : L === 'nl' ? 'nl-NL' : 'en-US';
const fmt = (n: number) => n.toLocaleString(NUM_LOCALE);

const volumeBurn = Math.round(VOLUME_CONTACTS / OPPORTUNITIES);
const precisionBurn = Math.round(PRECISION_CONTACTS / OPPORTUNITIES);
const ratio = Math.round(volumeBurn / precisionBurn);
---

<section class="sec sec--esp vvp" aria-labelledby="vvp-title" data-vvp data-num-locale={NUM_LOCALE}>
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow is-accent">{c.eyebrow}</p>
      <h2 id="vvp-title" class="heading_primary" style="margin-top:8px">{c.titlePre}<span class="accent">{c.titleAccent}</span>{c.titlePost}</h2>
      <p class="subheading vvp__lede">{c.lede}</p>
    </div>

    <div class="vvp__panels reveal">
      <article class="vvp-panel vvp-panel--volume">
        <span class="vvp-tag vvp-tag--danger"><span class="vvp-tag__dot"></span>{c.volTag}</span>
        <h3 class="heading_small vvp-panel__title">{c.volTitle}</h3>
        <p class="vvp-panel__sub">{c.volSub}</p>

        <div class="vvp-field" role="img" aria-label={c.volAria}>
          <svg class="vvp-field__svg" viewBox={`0 0 ${vbWidth} ${vbHeight}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              {/* One tile, tiled by the browser. See the performance note above. */}
              <pattern id="vvp-dot-base" width={STEP} height={STEP} patternUnits="userSpaceOnUse">
                <rect width={SIZE} height={SIZE} rx="1" class="vvp-dot vvp-dot--base" />
              </pattern>
              <pattern id="vvp-dot-hit" width={STEP} height={STEP} patternUnits="userSpaceOnUse">
                <rect width={SIZE} height={SIZE} rx="1" class="vvp-dot vvp-dot--danger" />
              </pattern>
            </defs>
            <rect width={vbWidth} height={vbHeight} fill="url(#vvp-dot-base)" />
            <g class="vvp-field__hit">
              <rect width={vbWidth} height={vbHeight} fill="url(#vvp-dot-hit)" />
            </g>
          </svg>
          <span class="vvp-sweep" aria-hidden="true"></span>
          <span class="vvp-field__caption">{c.dotCaption}</span>
        </div>

        <div class="vvp-readout">
          <div class="vvp-metric">
            <span class="vvp-metric__value" data-count-to={VOLUME_CONTACTS}>{fmt(VOLUME_CONTACTS)}</span>
            <span class="vvp-metric__label">{c.contactsLabel}</span>
          </div>
          <div class="vvp-metric vvp-metric--out">
            <span class="vvp-metric__value">{OPPORTUNITIES}</span>
            <span class="vvp-metric__label">{c.oppsLabel}</span>
          </div>
        </div>

        <p class="vvp-chain">{c.volChain}</p>
        <p class="vvp-after vvp-after--bad">{c.volAfter}</p>
      </article>

      <article class="vvp-panel vvp-panel--precision">
        <span class="vvp-tag vvp-tag--success"><span class="vvp-tag__dot"></span>{c.preTag}</span>
        <h3 class="heading_small vvp-panel__title">{c.preTitle}</h3>
        <p class="vvp-panel__sub">{c.preSub}</p>

        <div class="vvp-field" role="img" aria-label={c.preAria}>
          <svg class="vvp-field__svg" viewBox={`0 0 ${vbWidth} ${vbHeight}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <defs>
              {/* Its own copy rather than a reference into the other panel's
                  SVG: cross-<svg> fragment references are resolved
                  inconsistently across browsers. */}
              <pattern id="vvp-dot-base-2" width={STEP} height={STEP} patternUnits="userSpaceOnUse">
                <rect width={SIZE} height={SIZE} rx="1" class="vvp-dot vvp-dot--base" />
              </pattern>
            </defs>
            <rect width={vbWidth} height={vbHeight} fill="url(#vvp-dot-base-2)" />
            <g class="vvp-field__hit">
              {/* clip-path on an SVG <g> resolves against that group's own
                  bounding box. Without this invisible full-size rect the box
                  would be just the scattered dots, so the reveal would run out
                  of step with the sweep overlay above it. */}
              <rect width={vbWidth} height={vbHeight} fill="none" />
              {/* The only real dot elements on the page: the 20 that get touched. */}
              {picked.map((d) => (
                <rect x={d.x} y={d.y} width={SIZE} height={SIZE} rx="1" class="vvp-dot vvp-dot--success" />
              ))}
            </g>
          </svg>
          <span class="vvp-sweep" aria-hidden="true"></span>
          <span class="vvp-field__caption">{c.dotCaption}</span>
        </div>

        <div class="vvp-readout">
          <div class="vvp-metric">
            <span class="vvp-metric__value" data-count-to={PRECISION_CONTACTS}>{fmt(PRECISION_CONTACTS)}</span>
            <span class="vvp-metric__label">{c.contactsLabel}</span>
          </div>
          <div class="vvp-metric vvp-metric--out">
            <span class="vvp-metric__value">{OPPORTUNITIES}</span>
            <span class="vvp-metric__label">{c.oppsLabel}</span>
          </div>
        </div>

        <p class="vvp-chain">{c.preChain}</p>
        <p class="vvp-after vvp-after--good">{c.preAfter}</p>
      </article>
    </div>

    <div class="vvp-kicker reveal">
      <span class="vvp-kicker__label">{c.kickerLabel}</span>
      <span class="vvp-kicker__pair">
        <span class="vvp-kicker__bad">{fmt(volumeBurn)}</span>
        <span class="vvp-kicker__vs">{c.vs}</span>
        <span class="vvp-kicker__good">{fmt(precisionBurn)}</span>
      </span>
      <span class="vvp-kicker__x">{ratio}{c.kickerXPost}</span>
    </div>

    {/* The two motion names are bolded so the assumptions can be scanned as
        two blocks rather than one run-on paragraph. */}
    <p class="vvp-note">
      <b>{c.noteVolLabel}</b> {c.noteVolBody} <b>{c.notePreLabel}</b> {c.notePreBody}
    </p>
  </div>
</section>

<style>
  /* Colours come from the section role tokens (--sec-bg/-tx/-bd/-card), so this
     band flips with the rest of the page under [data-theme="dark"]. Semantic
     green and red are the global --positive / --error tokens. */
  /* The section sits on a dark espresso fill, between the paper logo strip
     above and the white Comparison below, so it breaks cleanly against both.
     --error and --positive are tuned for light surfaces and go muddy here, so
     the panels use brighter variants. These are the same two values the kicker
     already used when IT was the dark element. */
  .vvp{ --vvp-bad:#FF7A66; --vvp-good:#5FD39C; }

  .vvp__lede{ margin-top:14px; max-width:58ch; }

  .vvp__panels{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:32px; }
  @media (max-width:880px){ .vvp__panels{ grid-template-columns:1fr; } }

  .vvp-panel{
    background:var(--sec-card); border:1px solid var(--sec-bd);
    border-radius:var(--radius-lg); padding:24px 24px 20px;
    display:flex; flex-direction:column;
  }

  .vvp-tag{
    display:inline-flex; align-items:center; gap:7px; align-self:flex-start;
    font:600 12px/1 var(--font-body); padding:6px 11px; border-radius:999px;
    margin-bottom:14px;
  }
  .vvp-tag__dot{ width:6px; height:6px; border-radius:50%; background:currentColor; }
  .vvp-tag--danger{ color:var(--vvp-bad); background:color-mix(in srgb, var(--vvp-bad) 14%, transparent); }
  .vvp-tag--success{ color:var(--vvp-good); background:color-mix(in srgb, var(--vvp-good) 14%, transparent); }

  .vvp-panel__title{ margin:0 0 5px; }
  .vvp-panel__sub{
    font-size:14px; line-height:1.5; color:var(--sec-tx); opacity:.72;
    margin:0 0 20px; min-height:42px;
  }

  .vvp-field{
    position:relative; border-radius:var(--radius); overflow:hidden;
    background:var(--sec-bg); border:1px solid var(--sec-bd);
    padding:12px 12px 26px;
  }
  .vvp-field__svg{ display:block; width:100%; height:auto; }
  .vvp-dot--base{ fill:color-mix(in srgb, var(--sec-tx) 22%, transparent); }
  .vvp-dot--danger{ fill:var(--vvp-bad); }
  .vvp-dot--success{ fill:var(--vvp-good); }
  /* Hidden until the sweep uncovers it, left to right, but only when motion
     is on. Unconditionally hiding it meant a failed script left the dots
     blank for good. */
  html.has-anim .vvp-field__hit{ clip-path:inset(0 100% 0 0); }

  .vvp-sweep{
    position:absolute; top:0; bottom:0; left:0;
    width:36px; margin-left:-18px; opacity:0; pointer-events:none;
    background:linear-gradient(90deg, transparent,
      color-mix(in srgb, var(--accent-on) 18%, transparent) 45%,
      var(--accent-on) 50%,
      color-mix(in srgb, var(--accent-on) 18%, transparent) 55%, transparent);
  }

  .vvp-field__caption{
    position:absolute; right:10px; bottom:8px;
    font:500 10px/1 var(--font-body); letter-spacing:.04em;
    color:var(--sec-tx); opacity:.6;
    background:color-mix(in srgb, var(--sec-bg) 85%, transparent);
    padding:3px 6px; border-radius:4px;
  }

  .vvp-readout{
    display:flex; align-items:flex-end; gap:18px;
    margin-top:20px; padding-top:18px; border-top:1px solid var(--sec-bd);
  }
  .vvp-metric{ flex:1; min-width:0; }
  .vvp-metric__value{
    display:block; font-family:var(--font-head); font-size:34px; line-height:1.05;
    font-weight:700; letter-spacing:-.02em; font-variant-numeric:tabular-nums;
  }
  .vvp-panel--volume .vvp-metric__value{ color:var(--vvp-bad); }
  .vvp-panel--precision .vvp-metric__value{ color:var(--vvp-good); }
  .vvp-metric__label{ display:block; font-size:12.5px; color:var(--sec-tx); opacity:.72; margin-top:5px; }

  .vvp-metric--out{ flex:0 0 auto; text-align:right; }
  html.has-anim .vvp-metric--out{ opacity:0; }
  .vvp-metric--out .vvp-metric__value{ color:var(--sec-tx); }
  .vvp-metric--out .vvp-metric__label{ opacity:.55; }

  .vvp-chain{
    font-size:11.5px; line-height:1.6; color:var(--sec-tx); opacity:.58;
    margin:16px 0 0; font-variant-numeric:tabular-nums;
  }
  .vvp-after{
    font-size:13.5px; line-height:1.5; font-weight:500;
    margin:12px 0 0; padding:10px 12px; border-radius:7px;
  }
  .vvp-after--bad{ color:var(--vvp-bad); background:color-mix(in srgb, var(--vvp-bad) 12%, transparent); }
  .vvp-after--good{ color:var(--vvp-good); background:color-mix(in srgb, var(--vvp-good) 14%, transparent); }

  /* The kicker is the stamped conclusion, so it inverts against whatever the
     section is. The section is dark, so this is a cream slab; on it the normal
     light-surface --error / --positive read correctly again. */
  .vvp-kicker{
    margin-top:20px; background:#FBF4EA; border-radius:var(--radius-lg);
    padding:26px 28px; display:flex; flex-wrap:wrap;
    align-items:center; justify-content:space-between; gap:20px;
  }
  .vvp-kicker__label{
    font:700 12px/1.3 var(--font-body); letter-spacing:.1em;
    text-transform:uppercase; color:#6B5D52;   /* 5.8:1 on the cream slab */
  }
  .vvp-kicker__pair{
    display:flex; align-items:baseline; gap:14px;
    font-family:var(--font-head); font-size:clamp(30px,5vw,46px);
    font-weight:700; letter-spacing:-.02em; font-variant-numeric:tabular-nums;
  }
  /* Darker than --error / --positive, which only reach ~3:1 on cream and
     would pass for the big numerals but not for anything smaller. */
  .vvp-kicker__bad{ color:#C93A2D; }
  .vvp-kicker__vs{ font-family:var(--font-body); font-size:15px; font-weight:400; color:#6B5D52; }
  .vvp-kicker__good{ color:#1E7A52; }
  .vvp-kicker__x{
    font:600 15px/1 var(--font-head); color:#2B1E17;
    background:rgba(43,30,23,.07); border:1px solid rgba(43,30,23,.16);
    padding:9px 16px; border-radius:999px;
  }

  .vvp-note{ font-size:12px; line-height:1.6; color:var(--sec-tx); opacity:.5; margin:18px 0 0; }
  .vvp-note b{ font-weight:600; opacity:.85; }

  /* ---- Motion. The scene builds itself ONCE when the section is first seen,
     then holds. It used to loop on a 9 second cycle, which meant every number
     on screen faded to nothing for roughly four seconds out of every nine and
     then climbed again, so a reader who paused on the figures watched them
     disappear. Every animation now ends on the resolved state and keeps it with
     animation-fill-mode: forwards. ---- */
  .vvp.is-playing .vvp-field__hit{ animation:vvp-reveal 2800ms linear forwards; }
  .vvp.is-playing .vvp-sweep{ animation:vvp-sweep 2800ms linear forwards; }
  .vvp.is-playing .vvp-metric--out{ animation:vvp-pop 460ms ease-out 2650ms forwards; }
  .vvp.is-playing .vvp-kicker__pair > span{ animation:vvp-pop-late 460ms ease-out 3050ms forwards; }

  @keyframes vvp-reveal{
    from { clip-path:inset(0 100% 0 0); }
    to   { clip-path:inset(0 0 0 0); }
  }
  @keyframes vvp-sweep{
    0%   { left:0%;   opacity:0; }
    6%   { opacity:.95; }
    94%  { opacity:.95; }
    100% { left:100%; opacity:0; }
  }
  @keyframes vvp-pop{
    from { opacity:0; transform:translateY(7px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes vvp-pop-late{
    from { opacity:0; transform:translateY(9px); }
    to   { opacity:1; transform:translateY(0); }
  }

  /* Everything resolved, nothing moving. */
  @media (prefers-reduced-motion:reduce){
    .vvp.is-playing .vvp-field__hit,
    .vvp.is-playing .vvp-sweep,
    .vvp.is-playing .vvp-metric--out,
    .vvp.is-playing .vvp-kicker__pair > span{ animation:none; }
    html.has-anim .vvp-field__hit{ clip-path:inset(0 0 0 0); }
    html.has-anim .vvp-metric--out{ opacity:1; }
    .vvp-kicker__pair > span{ opacity:1; }
    .vvp-sweep{ display:none; }
  }
</style>

<script>
  // Counts the two contact figures up in step with the CSS reveal. The CSS owns
  // the timeline; this only reads the same clock, so the numbers and the sweep
  // can never drift apart.
  //
  // This runs ONCE. It used to loop forever on a 9 second cycle and stop when
  // the section left the viewport, which had two bad effects: the figures blanked
  // for part of every cycle while someone was reading them, and scrolling down
  // far enough tore the whole scene back down to its hidden resting state. Now
  // the count runs once, lands on the real number, and stays there whatever the
  // reader does next.
  const REVEAL = 2800;    // matches the CSS reveal duration
  const ease = (x: number) => 1 - Math.pow(1 - x, 3);

  function initVvp() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-vvp]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = 'true';

      const numLocale = root.dataset.numLocale || 'en-US';
      const fmt = (n: number) => n.toLocaleString(numLocale);
      const counters = Array.from(root.querySelectorAll<HTMLElement>('[data-count-to]'))
        .map((el) => ({ el, to: Number(el.dataset.countTo) }));

      // Reduced motion: show the finished state and never start a loop.
      if (reduce) {
        root.classList.add('is-playing');
        counters.forEach((c) => (c.el.textContent = fmt(c.to)));
        return;
      }

      let t0 = 0;

      const frame = (now: number) => {
        const p = Math.min(1, (now - t0) / REVEAL);
        counters.forEach((c) => (c.el.textContent = fmt(Math.round(c.to * ease(p)))));
        // Land exactly on the real figure, then stop. No further frames, so the
        // numbers cannot be repainted or cleared by anything later.
        if (p < 1) requestAnimationFrame(frame);
        else counters.forEach((c) => (c.el.textContent = fmt(c.to)));
      };

      // Plays the first time the section is seen, then the observer is dropped.
      // Nothing listens for it leaving, because there is nothing left to undo.
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        t0 = performance.now();
        root.classList.add('is-playing');
        requestAnimationFrame(frame);
      }, { threshold: 0.2 });
      io.observe(root);
    });
  }

  initVvp();
  document.addEventListener('astro:page-load', initVvp);
</script>
