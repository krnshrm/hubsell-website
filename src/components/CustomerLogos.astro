---
// Section 2 — Customer logos (Paper). A static, hand-picked "shelf": a bordered strip
// of equal cells divided by thin hairlines (styled after salesforge.ai's logo band),
// instead of the old auto-scrolling marquee. Top row = the five companies with a
// published customer story: each cell links to its story and carries a small corner
// arrow as the "story attached" indicator. Bottom row = five more trusted logos, shown
// plain. Every cell is a white card in BOTH themes so the colourful, light-background
// logos stay legible on the dark section. UI strings localize from the locale.
import { getCollection } from 'astro:content';
import { getHome } from '../data/home-i18n';
import { getCustomerStoriesPage } from '../i18n/pages';
import { asLocale, localizedHref } from '../i18n/utils';

const L = asLocale(Astro.currentLocale);
const { s } = getHome(L);
const cs = getCustomerStoriesPage(L);

// Story detail for the hover panel. Same per-locale collection pattern as
// PlatformStoryCard.astro, so the quote and the metric arrive already translated.
const collName = L === 'de' ? 'customerstoriesDe' : L === 'nl' ? 'customerstoriesNl' : 'customerstories';
const storyData = new Map(
  (await getCollection(collName as 'customerstories')).map((e) => [e.id, e.data as any]),
);

// Testimonials are stored wrapped in quote marks. The panel adds its own
// styling, so strip whatever kind of quote character is on the ends.
const unquote = (t: string) => String(t ?? '').trim().replace(/^["“”„'']+|["“”„'']+$/g, '').trim();

// Cut at a word boundary so the quote ends cleanly instead of mid-word where
// the CSS clamp would chop it. German runs longer than English, so the limit is
// deliberately conservative.
function clip(t: string, max = 120) {
  if (t.length <= max) return t;
  const cut = t.slice(0, max);
  const at = cut.lastIndexOf(' ');
  return (at > 40 ? cut.slice(0, at) : cut).replace(/[,;:.\s]+$/, '') + '…';
}

function panelFor(slug: string) {
  const d = storyData.get(slug);
  if (!d) return null;
  const top = (d.results ?? [])[0];
  const quote = clip(unquote(d.testimonial));
  if (!top && !quote) return null;
  return {
    metric: top?.metric ?? '',
    label: top?.label ?? '',
    quote,
    // The person who said it. A quote with a face behind it lands differently
    // from an anonymous one.
    champion: d.champion ?? '',
    championTitle: d.championTitle ?? '',
    championImage: d.championImage ?? '',
  };
}

// Row 1 — companies with a published customer story: linked + corner-arrow indicator.
// `slug` maps to /customerstories/<slug> (localized at render).
const storyLogos = [
  { name: 'Safran Software', slug: 'safran',       src: 'https://assets.hubsell.com/logos/6998a5a3d1e6f3a4831a8f45_Safran-Software.svg' },
  { name: 'Staffbase',       slug: 'staffbase',    src: 'https://assets.hubsell.com/logos/6998a5a331fa506eb2472cc2_Staffbase.svg' },
  { name: 'Verhaert',        slug: 'verhaert',     src: 'https://assets.hubsell.com/logos/6998a5a50b8cbce05a34c8f6_Verhaert.svg' },
  { name: 'Workspace 365',   slug: 'workspace365', src: 'https://assets.hubsell.com/logos/6998a5a52084daa6c519f180_Workspace-365.svg' },
  { name: 'Sensolus',        slug: 'sensolus',     src: 'https://assets.hubsell.com/logos/6998a5a3d68828bdce8239a2_Sensolus.svg' },
];

// Row 2 — additional hand-picked logos (no story): shown plain.
const moreLogos = [
  { name: 'GLS',       src: 'https://assets.hubsell.com/logos/6998a5a0115d997ba479a747_GLS-Sprachenzentrum.svg' },
  { name: 'FABs',      src: 'https://assets.hubsell.com/logos/6998a5a06aeabbbea89c3080_FABs.svg' },
  { name: 'ipushpull', src: 'https://assets.hubsell.com/logos/6998a5a1c67db980e6458cd0_ipushpull.svg' },
  { name: 'Kapturall', src: 'https://assets.hubsell.com/logos/6998a5a1a86ab14f562fc7c2_Kapturall.svg' },
  { name: 'Monotype',  src: 'https://assets.hubsell.com/logos/6998f31e8d66e1f222d84ab6_Monotype.avif' },
];
---
<section class="sec sec--paper" aria-label={s.logos.aria}>
  <div class="wrap">
    <p class="eyebrow logos-eyebrow">{s.logos.eyebrow}</p>

    <div class="logo-strip reveal">
      <div class="logo-grid">
        {storyLogos.map((l) => {
          const p = panelFor(l.slug);
          return (
            <a class="logo-cell logo-cell--story" href={localizedHref(L, `/customerstories/${l.slug}`)} aria-label={`${l.name} — ${cs.eyebrowStory}`}>
              <svg class="logo-cell__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
              <img class="logo-cell__img" src={l.src} alt={l.name} loading="lazy" decoding="async" width="130" height="30" />
              {p && (
                /* aria-hidden: the link's own aria-label already announces the story,
                   so a screen reader should not read this twice. */
                <span class="logo-panel" aria-hidden="true">
                  <span class="logo-panel__co">{l.name}</span>
                  {p.metric && (
                    <span class="logo-panel__metric">
                      <b>{p.metric}</b>
                      {p.label && <i>{p.label}</i>}
                    </span>
                  )}
                  {p.quote && <span class="logo-panel__quote">{p.quote}</span>}
                  {p.champion && (
                    <span class="logo-panel__who">
                      {p.championImage && (
                        <img class="logo-panel__face" src={p.championImage} alt="" width="34" height="34" loading="lazy" decoding="async" />
                      )}
                      <span class="logo-panel__whotx">
                        <b>{p.champion}</b>
                        {p.championTitle && <i>{p.championTitle}</i>}
                      </span>
                    </span>
                  )}
                  <span class="logo-panel__cta">{cs.readStory}</span>
                </span>
              )}
            </a>
          );
        })}
        {moreLogos.map((l) => (
          <div class="logo-cell">
            <img class="logo-cell__img" src={l.src} alt={l.name} loading="lazy" decoding="async" width="130" height="30" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .logos-eyebrow { text-align:center; margin-bottom:26px; }

  /* The "shelf": a framed strip whose 1px gaps show the border colour as hairline
     dividers between cells. overflow+radius round the outer corners. */
  .logo-strip{
    border:1px solid var(--sec-bd);
    border-radius:var(--radius-lg);
    background:var(--sec-bd);            /* shows through the grid gaps as dividers */
    /* No overflow:hidden. The hover card lifts out above the frame, and a
       clipping ancestor would cut it off. The outer corners are rounded on the
       four corner cells instead. */
  }
  .logo-grid{
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:1px;                             /* the hairlines */
  }

  /* Every cell is a white card in both themes so the light-background logos read on
     the dark section too. */
  .logo-cell{
    position:relative;
    display:flex; align-items:center; justify-content:center;
    min-height:112px; padding:28px 22px;
    background:#FFFFFF;
    text-decoration:none;
    transition:background .15s;
  }
  /* 5 x 2 grid: cells 1, 5, 6 and 10 are the corners. */
  .logo-cell:nth-child(1){ border-top-left-radius:calc(var(--radius-lg) - 1px); }
  .logo-cell:nth-child(5){ border-top-right-radius:calc(var(--radius-lg) - 1px); }
  .logo-cell:nth-child(6){ border-bottom-left-radius:calc(var(--radius-lg) - 1px); }
  .logo-cell:nth-child(10){ border-bottom-right-radius:calc(var(--radius-lg) - 1px); }

  .logo-cell__img{
    /* max-width is relative to the cell, not a fixed 150px. At two columns on a
       375px phone the content box is only ~135px, so a fixed cap let wide logos
       run past the cell edge. Whichever of the two limits binds first wins. */
    max-height:30px; max-width:100%; width:auto; height:auto;
    object-fit:contain; display:block;
  }

  /* Story cells: clickable, with a small corner arrow as the "story attached" cue.
     The arrow and hover accent use the fixed brand terracotta (the cell is always
     white, so the theme accent isn't needed). */
  .logo-cell--story{ cursor:pointer; }
  .logo-cell__arrow{
    position:absolute; top:12px; right:12px;
    width:15px; height:15px;
    color:#9A8F84;                      /* muted taupe at rest */
    transition:color .15s, transform .15s;
  }
  .logo-cell--story:hover{ background:#FCF7F2; }        /* faint warm tint */
  .logo-cell--story:hover .logo-cell__arrow{
    color:var(--brand);
    transform:translate(1px,-1px);
  }
  .logo-cell--story:focus-visible{ outline:2px solid var(--brand); outline-offset:-2px; }

  /* ---- Hover card -------------------------------------------------------
     Lifts out of the cell and floats above the frame, so it is not limited to
     the logo's own box. Only the top row carries stories, so every card rises
     into the dark band above the strip. */
  .logo-cell--story:hover,
  .logo-cell--story:focus-visible{ z-index:3; }   /* sit above the neighbouring cells */

  .logo-panel{
    position:absolute;
    left:50%; bottom:calc(100% - 34px);           /* overlaps the cell's top edge slightly */
    width:300px; max-width:min(300px, 82vw);
    display:flex; flex-direction:column; gap:8px;
    padding:16px 18px 15px;
    background:#FFFFFF;
    border:1px solid rgba(31,26,22,.10);
    border-radius:14px;
    box-shadow:0 20px 44px rgba(0,0,0,.30), 0 3px 10px rgba(0,0,0,.12);
    text-align:left;
    opacity:0; visibility:hidden; pointer-events:none;
    transform:translate(-50%, 10px);
    transition:opacity .22s ease, transform .28s cubic-bezier(.22,.61,.36,1), visibility .28s;
  }
  .logo-cell--story:hover .logo-panel,
  .logo-cell--story:focus-visible .logo-panel{
    opacity:1; visibility:visible;
    transform:translate(-50%, 0);
  }

  /* The end cells would push a centred card past the frame, so pin those to
     their own edge instead. */
  .logo-cell--story:nth-child(1) .logo-panel{ left:0; transform:translate(0, 10px); }
  .logo-cell--story:nth-child(1):hover .logo-panel,
  .logo-cell--story:nth-child(1):focus-visible .logo-panel{ transform:translate(0, 0); }
  .logo-cell--story:nth-child(5) .logo-panel{ left:auto; right:0; transform:translate(0, 10px); }
  .logo-cell--story:nth-child(5):hover .logo-panel,
  .logo-cell--story:nth-child(5):focus-visible .logo-panel{ transform:translate(0, 0); }

  .logo-panel__co{
    font:600 10px/1 var(--font-body);
    letter-spacing:.1em; text-transform:uppercase; color:#9A8F84;
  }
  .logo-panel__metric{ display:flex; align-items:baseline; gap:7px; }
  .logo-panel__metric b{
    font:700 24px/1 var(--font-head);
    color:var(--brand);
    letter-spacing:-.01em;
  }
  .logo-panel__metric i{
    font-style:normal; font-size:12px; line-height:1.25; color:#6B635B;
  }
  .logo-panel__quote{
    font-size:12.5px; line-height:1.5; color:#4A443E;
    display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .logo-panel__who{ display:flex; align-items:center; gap:9px; }
  .logo-panel__face{
    width:34px; height:34px; border-radius:50%; object-fit:cover;
    background:#EFEAE3; flex-shrink:0;
  }
  .logo-panel__whotx{ display:flex; flex-direction:column; gap:2px; min-width:0; }
  .logo-panel__whotx b{ font:600 12px/1.2 var(--font-body); color:#2A2420; }
  .logo-panel__whotx i{ font-style:normal; font-size:10.5px; line-height:1.2; color:#8B8279; }

  .logo-panel__cta{
    font:600 10.5px/1 var(--font-body);
    letter-spacing:.06em; text-transform:uppercase; color:var(--brand);
  }

  @media (prefers-reduced-motion:reduce){
    .logo-panel{ transition:none; }
  }

  /* Touch screens have no hover, and a panel that only opens on tap would
     swallow the tap that should follow the link. Below the breakpoint the cell
     goes back to being a plain logo with its corner arrow. */
  @media (max-width:820px){
    .logo-grid{ grid-template-columns:repeat(2, 1fr); }
    .logo-cell{ min-height:96px; padding:22px 16px; }
    .logo-panel{ display:none; }
    /* Two columns moves the corners, and with no card to let out the frame can
       go back to clipping. */
    .logo-strip{ overflow:hidden; }
    .logo-cell{ border-radius:0; }
  }
  @media (hover:none){
    .logo-panel{ display:none; }
  }
</style>
