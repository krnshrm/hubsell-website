---
// Cookie banner. GTM (and through it GA4) loads only after the visitor clicks
// Accept, as the privacy policy (section 6.5.2) promises for analytical cookies.
// Accept and Decline are styled the same on purpose: under GDPR, refusing must be
// as easy as agreeing. The choice lives in localStorage; the footer's "Cookie
// settings" link reopens the banner.
import { GTM_ID } from '../data/site';
import { asLocale, localizedHref } from '../i18n/utils';

const L = asLocale(Astro.currentLocale);
const COPY = {
  en: {
    label: 'Cookie consent',
    body: 'We use Google Analytics to see which pages help visitors, but only if you agree. Nothing is loaded until you choose.',
    policy: 'Privacy Policy',
    accept: 'Accept',
    decline: 'Decline',
  },
  de: {
    label: 'Cookie-Einwilligung',
    body: 'Wir nutzen Google Analytics, um zu sehen, welche Seiten Besuchern helfen, aber nur mit Ihrer Zustimmung. Bis Sie wählen, wird nichts geladen.',
    policy: 'Datenschutzerklärung',
    accept: 'Akzeptieren',
    decline: 'Ablehnen',
  },
  nl: {
    label: 'Cookietoestemming',
    body: 'We gebruiken Google Analytics om te zien welke pagina’s bezoekers helpen, maar alleen met uw toestemming. Tot u kiest, wordt er niets geladen.',
    policy: 'Privacybeleid',
    accept: 'Accepteren',
    decline: 'Weigeren',
  },
} as const;
const c = COPY[L as keyof typeof COPY] ?? COPY.en;
---
<div class="consent" role="dialog" aria-live="polite" aria-label={c.label} data-consent hidden>
  <p class="consent__body">
    {c.body} <a href={`${localizedHref(L, '/privacy')}#6-cookies`}>{c.policy}</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="consent__btn" data-consent-choice="denied">{c.decline}</button>
    <button type="button" class="consent__btn" data-consent-choice="granted">{c.accept}</button>
  </div>
</div>

<script is:inline define:vars={{ gtmId: GTM_ID }}>
  (function () {
    var KEY = 'consent.analytics';
    var banner = document.querySelector('[data-consent]');

    function read() {
      try { return localStorage.getItem(KEY); } catch (e) { return null; }
    }
    function write(v) {
      try { localStorage.setItem(KEY, v); } catch (e) {}
    }
    function loadGtm() {
      if (window.__gtmLoaded) return;
      window.__gtmLoaded = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      document.head.appendChild(s);
    }
    // GA4 sets _ga and _ga_<id> on the registrable domain; clear both forms so a
    // withdrawn consent actually removes them.
    function clearGaCookies() {
      document.cookie.split(';').forEach(function (part) {
        var name = part.split('=')[0].trim();
        if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
        ['', '; domain=.hubsell.com', '; domain=hubsell.com'].forEach(function (d) {
          document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
        });
      });
    }

    var choice = read();
    if (choice === 'granted') loadGtm();
    else if (choice !== 'denied' && banner) banner.hidden = false;

    if (banner) {
      banner.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-consent-choice]');
        if (!btn) return;
        var next = btn.getAttribute('data-consent-choice');
        var wasGranted = read() === 'granted';
        write(next);
        banner.hidden = true;
        if (next === 'granted') loadGtm();
        // GTM cannot be unloaded from a running page, so a withdrawal reloads.
        else if (wasGranted) { clearGaCookies(); location.reload(); }
      });
    }
    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-consent-open]') || !banner) return;
      e.preventDefault();
      banner.hidden = false;
      var first = banner.querySelector('button');
      if (first) first.focus();
    });
  })();
</script>

<style>
  .consent {
    position: fixed; z-index: 9000; left: 16px; right: 16px; bottom: 16px;
    max-width: 560px; margin-left: auto;
    display: flex; flex-direction: column; gap: 14px;
    padding: 18px 20px; border-radius: 14px;
    background: var(--chrome-bg); color: var(--chrome-tx);
    border: 1px solid var(--chrome-bd);
    box-shadow: 0 12px 40px rgba(0, 0, 0, .22);
    font-family: var(--font-body); font-size: 14px; line-height: 1.5;
  }
  .consent[hidden] { display: none; }
  .consent__body { margin: 0; }
  .consent__body a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .consent__actions { display: flex; gap: 10px; justify-content: flex-end; }
  .consent__btn {
    flex: 0 1 140px; min-height: 40px; padding: 8px 18px; border-radius: 8px;
    font: inherit; font-weight: 500; cursor: pointer;
    background: transparent; color: var(--chrome-tx);
    border: 1px solid color-mix(in srgb, var(--chrome-tx) 45%, transparent);
    transition: background .15s, border-color .15s;
  }
  .consent__btn:hover { background: color-mix(in srgb, var(--chrome-tx) 10%, transparent); border-color: var(--chrome-tx); }
  .consent__btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  @media (max-width: 480px) { .consent__btn { flex: 1 1 0; } }
</style>
