---
// The knowledge centre header.
// A leaner bar than the marketing Nav: logo, section name, a link back to the
// main site, and (on mobile) the button that opens the
// sidebar drawer. Deliberately has no mega-menu, so a reader in help mode is
// not pulled back into marketing navigation.
//
// The CTA is "Log in", not "Book a demo": people reading the knowledge centre
// are already customers, so the useful action is getting into the app. Wording
// matches the `cta.login` key the main nav uses, so the site says one thing.
import { LOGIN_URL } from '../../data/site';

const LOGO_DARK = 'https://assets.hubsell.com/logo/hubsell-wordmark-dark.svg';   // for light backgrounds
const LOGO_LIGHT = 'https://assets.hubsell.com/logo/hubsell-wordmark-light.svg'; // for dark backgrounds
---
<header class="kbhead">
  <div class="kbhead__in">
    <button type="button" class="kbhead__burger" id="kbBurger" aria-expanded="false" aria-controls="kbnav" aria-label="Open navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>

    <a class="kbhead__brand" href="/knowledge">
      <img class="kbhead__logo kbhead__logo--dark" src={LOGO_DARK} alt="hubsell" width="96" />
      <img class="kbhead__logo kbhead__logo--light" src={LOGO_LIGHT} alt="hubsell" width="96" />
      <span class="kbhead__sep" aria-hidden="true"></span>
      <span class="kbhead__label">Knowledge centre</span>
    </a>

    <div class="kbhead__right">
      <a class="kbhead__link" href="/">Back to hubsell.com</a>
      <a class="kbhead__link kbhead__link--cta" href={LOGIN_URL}>Log in</a>
    </div>
  </div>
</header>

<style>
  .kbhead{
    position:sticky; top:0; z-index:40;
    background:var(--bg); border-bottom:1px solid var(--border);
  }
  .kbhead__in{
    display:flex; align-items:center; gap:14px;
    max-width:1440px; margin:0 auto; padding:11px clamp(16px,3vw,32px);
  }

  .kbhead__brand{ display:flex; align-items:center; gap:11px; text-decoration:none; margin-right:auto; }
  .kbhead__logo{ width:96px; height:auto; display:block; }
  .kbhead__logo--light{ display:none; }

  .kbhead__sep{ width:1px; height:18px; background:var(--border-strong); }
  .kbhead__label{
    font-family:var(--font-head); font-weight:500; font-size:.9375rem; color:var(--text-2);
    white-space:nowrap;
  }

  .kbhead__right{ display:flex; align-items:center; gap:6px; }

  .kbhead__link{
    font-family:var(--font-body); font-size:14px; font-weight:500; color:var(--text-2);
    text-decoration:none; padding:7px 12px; border-radius:8px; white-space:nowrap;
  }
  .kbhead__link:hover{ color:var(--text); background:color-mix(in srgb, var(--text) 6%, transparent); }
  .kbhead__link--cta{
    color:var(--cta-tx); background:var(--cta-bg); border:1px solid transparent;
  }
  .kbhead__link--cta:hover{ color:var(--cta-tx); background:var(--cta-bg-hover); }

  .kbhead__burger{
    display:none; align-items:center; justify-content:center;
    width:34px; height:34px; padding:0; cursor:pointer;
    background:transparent; color:var(--text-2);
    border:1px solid var(--border); border-radius:8px;
  }
  .kbhead__burger svg{ width:17px; height:17px; }

  @media (max-width:1023px){
    .kbhead__burger{ display:inline-flex; }
    .kbhead__label, .kbhead__sep{ display:none; }
  }
  @media (max-width:640px){
    .kbhead__link:not(.kbhead__link--cta){ display:none; }
  }
</style>
