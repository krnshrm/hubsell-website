---
// LEARNING NOTES: the knowledge center sidebar
// --------------------------------------------
// Rendered on the hub, the category pages, and every article, so navigation is
// always visible. It fetches the article list itself rather than making every
// page pass one in.
//
// On desktop it is a sticky column. On mobile it collapses into a drawer that
// the header button opens (see KnowledgeHeader.astro); the markup is the same,
// only the CSS and a body class differ.
import { getCollection } from 'astro:content';
import { KNOWLEDGE_CATEGORIES, categoryRank } from '../../data/knowledge';

export interface Props {
  /** id of the current article, so it can be marked active. */
  activeSlug?: string;
  /** category name of the current page, so its group starts open. */
  activeCategory?: string;
}
const { activeSlug, activeCategory } = Astro.props;

const articles = await getCollection('knowledge', (a) => !a.data.draft);

// Group articles under their category, in the order defined in data/knowledge.ts.
const groups = KNOWLEDGE_CATEGORIES.map((cat) => ({
  ...cat,
  articles: articles
    .filter((a) => a.data.category === cat.name)
    .sort((x, y) => (x.data.order - y.data.order) || x.data.title.localeCompare(y.data.title)),
}))
  .filter((g) => g.articles.length > 0)
  .sort((a, b) => categoryRank(a.name) - categoryRank(b.name));
---
<nav class="kbnav" id="kbnav" aria-label="Knowledge center">
  <a class="kbnav__all" href="/knowledge">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
    All articles
  </a>

  {groups.map((group) => {
    const open = group.name === activeCategory;
    return (
      <section class="kbnav__group">
        <a class:list={['kbnav__cat', { 'is-active': open }]} href={`/knowledge/category/${group.slug}`}>
          {group.name}
        </a>
        <ul class="kbnav__list">
          {group.articles.map((a) => (
            <li>
              <a
                class:list={['kbnav__link', { 'is-current': a.id === activeSlug }]}
                href={`/knowledge/${a.id}`}
                aria-current={a.id === activeSlug ? 'page' : undefined}
              >
                {a.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</nav>

<style>
  .kbnav{ font-family:var(--font-body); }

  .kbnav__all{
    display:flex; align-items:center; gap:9px;
    font-size:14px; font-weight:500; color:var(--text-2); text-decoration:none;
    padding:8px 10px; border-radius:8px; margin-bottom:14px;
  }
  .kbnav__all svg{ width:15px; height:15px; }
  .kbnav__all:hover{ color:var(--accent-on); background:color-mix(in srgb, var(--text) 5%, transparent); }

  .kbnav__group{ margin-bottom:20px; }

  .kbnav__cat{
    display:block; font-family:var(--font-head); font-weight:600;
    font-size:.8125rem; text-transform:uppercase; letter-spacing:.07em;
    color:var(--text-3); text-decoration:none; padding:0 10px; margin-bottom:7px;
  }
  .kbnav__cat:hover{ color:var(--accent-on); }
  .kbnav__cat.is-active{ color:var(--text-2); }

  .kbnav__list{ list-style:none; margin:0; padding:0; }

  .kbnav__link{
    display:block; font-size:14px; line-height:1.45; color:var(--text-2);
    text-decoration:none; padding:7px 10px; border-radius:8px;
    border-left:2px solid transparent; margin-left:0;
  }
  .kbnav__link:hover{ color:var(--text); background:color-mix(in srgb, var(--text) 5%, transparent); }
  .kbnav__link.is-current{
    color:var(--accent-on); font-weight:500;
    background:color-mix(in srgb, var(--accent-on) 9%, transparent);
    border-left-color:var(--accent-on); border-radius:0 8px 8px 0;
  }
</style>
