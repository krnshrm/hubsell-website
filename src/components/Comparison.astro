---
// ============================= LEARNING NOTES =============================
// SECTION component: one visual band, stacked by a page file. The pattern
// (locale lookup, strings from src/data, semantic markup, scoped style) is
// explained in src/components/Hero.astro; browser-script mechanics in
// src/components/Faq.astro.
// No props: it reads Astro.currentLocale and fetches its own strings
// from src/data/ (home-i18n).
// The <style> block is scoped to this component (Astro hashes the
// selectors), styled with the design tokens from src/styles/global.css.
// ==========================================================================
// Homepage — "Why hubsell" comparison. Sets the competitive narrative early and
// tactfully: hubsell as the whole motion (live data + multichannel outreach +
// CRM sync) versus the categories of point tools you'd otherwise stitch together.
// Column headers + the footer links deep-link to the /vs comparison pages
// (Comparisons CMS collection: apollo, zoominfo, cognism, lusha, seamless).
// Competitor copy stays factual — positioning, never a put-down.
import { getHome } from '../data/home-i18n';
import { asLocale, localizedHref } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
const { comparison, s } = getHome(L);
const HUB_LOGO = 'https://assets.hubsell.com/logo/hubsell-wordmark-light.svg';

const cols = ['hub', 'aio', 'data', 'lookup'] as const;
const heads = comparison.heads;

// mark: 'yes' | 'part' | 'no'
const rows = comparison.rows;

const allComparisons = [
  { name: 'Apollo', href: '/vs/apollo' }, { name: 'ZoomInfo', href: '/vs/zoominfo' },
  { name: 'Cognism', href: '/vs/cognism' }, { name: 'Lusha', href: '/vs/lusha' },
  { name: 'Seamless', href: '/vs/seamless' },
];
const last = rows.length - 1;
---
<section class="sec sec--sand cmp" aria-labelledby="cmp-title">
  <div class="wrap">
    <p class="eyebrow cmp__eyebrow reveal">{s.cmp.eyebrow}</p>
    <h2 id="cmp-title" class="heading_primary cmp__title reveal">{s.cmp.title}</h2>
    <p class="subheading cmp__sub reveal">{s.cmp.sub}</p>

    <div class="cmp__matrixwrap reveal">
      <div class="cmp__matrix" data-cmp-matrix>
        <div class="cmp__corner"></div>
        {cols.map((c) => (
          heads[c].href
            ? <a class="cmp__head cmp__col-link" data-col={c} href={localizedHref(L, heads[c].href)}>{heads[c].label} <span aria-hidden="true">→</span></a>
            : <div class="cmp__head cmp__head--hub" data-col={c}><img class="cmp__hublogo" src={HUB_LOGO} alt="hubsell" /></div>
        ))}

        {rows.map((r, i) => (
          /* display:contents on desktop, so these stay direct grid items and the
             matrix is unchanged. Below 680px the wrapper becomes a card, which
             is the only way to escape a 780px-wide table on a phone. */
          <div class="cmp__row" style={`--row:${i}`}>
            <div class:list={["cmp__rowlabel", i === last && "is-lastrow"]}><span>{r.label}</span></div>
            {cols.map((c) => {
              const [mark, text] = r.cells[c];
              const isHub = c === 'hub';
              return (
                <div class:list={["cmp__cell", isHub && "cmp__cell--hub", i === last && "is-lastrow"]} data-col={c} data-collabel={heads[c].label}>
                  <span class={`mk mk--${mark}`}>
                    <span class="sr-only">{mark === 'yes' ? s.cmp.srYes : mark === 'part' ? s.cmp.srPart : s.cmp.srNo}</span>
                    {mark === 'yes'
                      ? <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.2l2.2 2.3 4.8-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      : <span aria-hidden="true">{mark === 'part' ? '~' : '–'}</span>}
                  </span>
                  <p>{text}</p>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </div>

    <p class="cmp__moat reveal">{s.cmp.moat}</p>

    <div class="cmp__links reveal">
      <span class="cmp__links-label">{s.cmp.linksLabel}</span>
      {allComparisons.map((c) => <a href={localizedHref(L, c.href)}>{c.name}</a>)}
    </div>
  </div>
</section>

<style>
  .cmp{ --hub-bg:#192341; --hub-tx:#FBF4EA; }
  .cmp__eyebrow{ text-align:center; margin:0 0 14px }
  .cmp__title{ text-align:center; max-width:20ch; margin:0 auto 16px }
  .cmp__sub{ text-align:center; max-width:62ch; margin:0 auto }

  .cmp__matrixwrap{
    margin-top:44px; overflow-x:auto; -webkit-overflow-scrolling:touch;
    /* contain:paint keeps the 780px matrix from inflating the mobile layout
       viewport (Chrome/Safari shrink-to-fit uses intrinsic content width, which
       overflow alone does not cap). Verified: without this, phones render the
       whole page at ~730px wide. */
    contain:paint;
  }
  .cmp__matrix{
    min-width:780px;
    display:grid;
    grid-template-columns:1.3fr 1.2fr repeat(3, 1fr);
    align-items:stretch;
  }
  /* The row wrapper has no box of its own on desktop, so its children remain
     direct grid items and the 5-column layout is untouched. */
  .cmp__row{ display:contents }
  /* Named explicitly rather than a descendant wildcard: `> * > *` would also
     catch the wordmark inside the hubsell header and pad it. */
  .cmp__corner, .cmp__head, .cmp__rowlabel, .cmp__cell{ padding:15px 14px }

  .cmp__corner{ border-bottom:1px solid var(--sec-bd) }
  .cmp__head{
    text-align:center; font-family:var(--font-body); font-weight:600; font-size:12.5px;
    letter-spacing:.05em; text-transform:uppercase; color:var(--sec-tx);
    display:flex; align-items:center; justify-content:center; gap:6px;
  }
  .cmp__head:not(.cmp__head--hub){ opacity:.58; border-bottom:1px solid var(--sec-bd); text-decoration:none; transition:opacity .15s, color .15s }
  .cmp__col-link:hover{ opacity:1; color:var(--accent-on) }
  .cmp__col-link span{ transition:transform .15s }
  .cmp__col-link:hover span{ transform:translateX(3px) }
  .cmp__hublogo{ height:18px; width:auto; display:block; margin:0 auto }

  .cmp__rowlabel{
    display:flex; align-items:center; font-family:var(--font-head); font-weight:600;
    font-size:14.5px; line-height:1.25; color:var(--sec-tx); border-bottom:1px solid var(--sec-bd);
  }
  .cmp__cell{ display:flex; flex-direction:column; align-items:center; gap:9px; text-align:center }
  .cmp__cell:not(.cmp__cell--hub){ border-bottom:1px solid var(--sec-bd) }
  .cmp__cell p{ margin:0; font-size:12px; line-height:1.4; color:var(--sec-tx); opacity:.66; max-width:19ch }

  /* hubsell centerpiece — contiguous dark column */
  .cmp__head--hub, .cmp__cell--hub{ background:var(--hub-bg); color:var(--hub-tx) }
  .cmp__cell--hub p{ color:var(--hub-tx); opacity:.84 }
  .cmp__head--hub{ border-radius:16px 16px 0 0 }
  .cmp__cell--hub.is-lastrow{ border-radius:0 0 16px 16px }

  .is-lastrow{ border-bottom:0 !important }

  .mk{
    width:24px; height:24px; border-radius:50%; flex:none;
    display:inline-flex; align-items:center; justify-content:center;
    font-size:13px; font-weight:700; line-height:1;
  }
  .mk--yes{ background:var(--accent-on); color:#FBF4EA }
  .mk--part{ background:var(--amber-soft); color:var(--amber-ink) }
  .mk--no{ background:color-mix(in srgb, var(--sec-tx) 10%, transparent); color:var(--sec-tx); opacity:.55 }

  .cmp__moat{ text-align:center; max-width:64ch; margin:34px auto 0; font-size:15px; line-height:1.55; color:var(--sec-tx); opacity:.72; font-style:italic }
  .cmp__links{ display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:9px 14px; margin-top:24px }
  .cmp__links-label{ font-size:13.5px; color:var(--sec-tx); opacity:.6 }
  .cmp__links a{ font-size:13.5px; font-weight:500; color:var(--accent-on); text-decoration:none; border-bottom:1px solid transparent; transition:border-color .15s }
  .cmp__links a:hover{ border-bottom-color:var(--accent-on) }

  /* ---- Motion -------------------------------------------------------------
     Two behaviours, both added by the script so the table is fully visible
     when JavaScript does not run.

     1. ROW CASCADE. Rows resolve top to bottom as the section scrolls in,
        once, then it is the static table again. Only cell CONTENTS animate,
        never the cells: the hubsell column is one contiguous dark block, and
        fading the cells themselves would break it into flickering pieces.
        The hubsell tick also draws itself along its own stroke, so the eye
        follows a column of accent building down the left while the rest of
        the grid settles grey.

     2. COLUMN SPOTLIGHT. Hovering or keyboard-focusing a column header dims
        the other columns' contents, so one tool can be read at a time. Again
        contents only, so the grid lines and the dark column stay put. */
  .cmp__matrix.is-anim .cmp__rowlabel > span,
  .cmp__matrix.is-anim .cmp__cell > .mk,
  .cmp__matrix.is-anim .cmp__cell > p{
    opacity:0; transform:translateY(7px);
  }
  .cmp__matrix.is-anim.is-in .cmp__rowlabel > span,
  .cmp__matrix.is-anim.is-in .cmp__cell > .mk,
  .cmp__matrix.is-anim.is-in .cmp__cell > p{
    opacity:1; transform:none;
    transition:opacity .42s ease, transform .42s cubic-bezier(.22,.61,.36,1);
    transition-delay:calc(var(--row, 0) * 110ms);
  }
  /* p keeps its resting opacity rather than snapping to 1 */
  .cmp__matrix.is-anim.is-in .cmp__cell > p{ opacity:.66; }
  .cmp__matrix.is-anim.is-in .cmp__cell--hub > p{ opacity:.84; }

  /* The tick draws itself. 12 comfortably exceeds the path's ~10 units. */
  .cmp__matrix.is-anim .mk--yes svg path{ stroke-dasharray:12; stroke-dashoffset:12; }
  .cmp__matrix.is-anim.is-in .mk--yes svg path{
    stroke-dashoffset:0;
    transition:stroke-dashoffset .38s ease;
    transition-delay:calc(var(--row, 0) * 110ms + 160ms);
  }

  /* Spotlight. One rule per column: an attribute selector cannot compare the
     focused key against each cell's own key. Contents only, so the grid lines
     and the dark hubsell block never move. The extra .is-anim in the selector
     is there to out-specify the cascade's resting opacities without !important.

     The hubsell column is NEVER dimmed. It is the reference every other column
     is being read against, so fading it defeats the point of the comparison.
     Hovering a competitor dims that competitor's rivals and leaves hubsell at
     full strength; hovering hubsell dims all three competitors. */
  .cmp__matrix[data-focus] .cmp__cell > .mk,
  .cmp__matrix[data-focus] .cmp__cell > p,
  .cmp__matrix[data-focus] .cmp__col-link{ transition:opacity .18s ease; }

  .cmp__matrix.is-anim[data-focus="hub"]    [data-col]:not([data-col="hub"])                             > .mk,
  .cmp__matrix.is-anim[data-focus="hub"]    [data-col]:not([data-col="hub"])                             > p,
  .cmp__matrix.is-anim[data-focus="aio"]    [data-col]:not([data-col="aio"]):not([data-col="hub"])       > .mk,
  .cmp__matrix.is-anim[data-focus="aio"]    [data-col]:not([data-col="aio"]):not([data-col="hub"])       > p,
  .cmp__matrix.is-anim[data-focus="data"]   [data-col]:not([data-col="data"]):not([data-col="hub"])      > .mk,
  .cmp__matrix.is-anim[data-focus="data"]   [data-col]:not([data-col="data"]):not([data-col="hub"])      > p,
  .cmp__matrix.is-anim[data-focus="lookup"] [data-col]:not([data-col="lookup"]):not([data-col="hub"])    > .mk,
  .cmp__matrix.is-anim[data-focus="lookup"] [data-col]:not([data-col="lookup"]):not([data-col="hub"])    > p{
    opacity:.2;
  }

  /* Competitor headers dim with their columns. The hubsell header is a dark
     block with the wordmark in it and stays untouched. */
  .cmp__matrix[data-focus="hub"]    .cmp__col-link,
  .cmp__matrix[data-focus="aio"]    .cmp__col-link:not([data-col="aio"]),
  .cmp__matrix[data-focus="data"]   .cmp__col-link:not([data-col="data"]),
  .cmp__matrix[data-focus="lookup"] .cmp__col-link:not([data-col="lookup"]){ opacity:.2; }

  /* Reduced motion: the finished table, no cascade, no draw-on. The spotlight
     stays because it is a reading aid, not decoration. */
  @media (prefers-reduced-motion:reduce){
    .cmp__matrix.is-anim .cmp__rowlabel > span,
    .cmp__matrix.is-anim .cmp__cell > .mk,
    .cmp__matrix.is-anim .cmp__cell > p{ opacity:1; transform:none; transition:none; }
    .cmp__matrix.is-anim .cmp__cell > p{ opacity:.66; }
    .cmp__matrix.is-anim .cmp__cell--hub > p{ opacity:.84; }
    .cmp__matrix.is-anim .mk--yes svg path{ stroke-dasharray:none; stroke-dashoffset:0; transition:none; }
  }

  /* ---- Phone layout -------------------------------------------------------
     A 780px-wide table on a 375px screen means horizontal scrolling, and most
     visitors never discover it, so the comparison simply does not get read.
     Below 680px the matrix stops being a grid: each capability becomes a card
     with four labelled rows inside it, hubsell first and still on its dark
     fill. Nothing is dropped and nothing needs scrolling sideways. */
  @media (max-width:680px){
    .cmp__matrixwrap{ overflow-x:visible; contain:none; }
    .cmp__matrix{ display:block; min-width:0; }

    /* The column headers become per-cell labels instead, via data-collabel. */
    .cmp__corner, .cmp__head{ display:none }

    .cmp__row{
      display:block; margin-top:14px;
      border:1px solid var(--sec-bd); border-radius:var(--radius-lg); overflow:hidden;
    }
    .cmp__rowlabel{
      display:block; border-bottom:1px solid var(--sec-bd);
      padding:13px 14px; font-size:14px;
      background:color-mix(in srgb, var(--sec-tx) 4%, transparent);
    }

    /* Each cell turns into one labelled line: who, the mark, the detail. */
    .cmp__matrix > * > .cmp__cell{
      display:grid; grid-template-columns:86px 24px 1fr;
      align-items:center; gap:10px; text-align:left;
      padding:11px 14px;
    }
    .cmp__cell::before{
      content:attr(data-collabel);
      font:600 10.5px/1.25 var(--font-body); letter-spacing:.05em; text-transform:uppercase;
      opacity:.62;
    }
    .cmp__cell p{ max-width:none; font-size:12.5px }
    .cmp__cell:not(.cmp__cell--hub){ border-bottom:1px solid var(--sec-bd) }
    .cmp__row .cmp__cell:last-child{ border-bottom:0 }
    /* hubsell already sits first in the DOM, so it leads each card, and it
       keeps its dark fill. */
    .cmp__cell--hub::before{ color:var(--hub-tx); opacity:.72 }
    .is-lastrow{ border-bottom:0 }
    .cmp__head--hub, .cmp__cell--hub.is-lastrow{ border-radius:0 }
  }
</style>

<script>
  // Progressive enhancement: the matrix ships fully visible, and only gets the
  // cascade once this runs. If the script never runs, nothing is hidden.
  function initComparison() {
    document.querySelectorAll<HTMLElement>('[data-cmp-matrix]').forEach((m) => {
      if (m.dataset.bound) return;
      m.dataset.bound = 'true';

      // ---- 1. row cascade, once ----
      m.classList.add('is-anim');
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        m.classList.add('is-in');
        io.disconnect();          // plays once, then it is a static table
      }, { threshold: 0.15 });
      io.observe(m);

      // ---- 2. column spotlight ----
      const setFocus = (col: string | null) => {
        if (col) m.dataset.focus = col;
        else delete m.dataset.focus;
      };
      m.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => {
        const col = el.dataset.col!;
        el.addEventListener('mouseenter', () => setFocus(col));
        el.addEventListener('focusin', () => setFocus(col));
      });
      m.addEventListener('mouseleave', () => setFocus(null));
      m.addEventListener('focusout', (e) => {
        if (!m.contains(e.relatedTarget as Node)) setFocus(null);
      });
    });
  }

  initComparison();
  document.addEventListener('astro:page-load', initComparison);
</script>
