---
// Trial (2026-10-13): from iPad landscape up, the homepage's navy sections
// become large rounded panels instead of full-width bands. The light sections
// keep their two shades (tint and white). The space around each panel takes
// the colour of the section before it, so the panel sits on that surface
// rather than cutting across the page. Remove this component to undo it.
---
<style is:global>
  @media (min-width:1024px) and (orientation:landscape){
    main:has(> .hs) > :is(.sec--navy, .sec--esp){
      --surround:var(--sec-paper);
      position:relative; isolation:isolate;
      background:var(--surround);
    }
    /* A component's <script> can sit between two sections. */
    main:has(> .hs) > :is(.sec--navy, .sec--esp):is(.sec--sand + *, .sec--sand + script + *){ --surround:var(--sec-sand) }
    main:has(> .hs) > :is(.sec--navy, .sec--esp)::before{
      content:''; position:absolute; z-index:-1;
      inset:0 clamp(16px,2vw,28px);
      border-radius:clamp(24px,2.4vw,36px);
      background:var(--sec-navy);
    }
  }
</style>
