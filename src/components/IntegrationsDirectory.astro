---
// The /integrations page: CRM and email integrations. Same section pattern as the
// platform pages. The hero visual shows hubsell between the mailboxes it sends
// from and the CRMs it writes to; both arrows point away from hubsell because the
// CRM sync is one-way today. Logos live on R2 (assets.hubsell.com/integrations).
import CtaGroup from './CtaGroup.astro';
import SectionHead from './SectionHead.astro';
import PlatformFaqPicks from './PlatformFaqPicks.astro';
import { localizedHref } from '../i18n/utils';
import { getHome } from '../data/home-i18n';
import type { IntegrationsPageData } from '../data/integrations-i18n';
import type { Locale } from '../i18n/ui';

interface Props { L: Locale; data: IntegrationsPageData }
const { L, data: d } = Astro.props;
const { s } = getHome(L);
const h = d.heads;
const LOGO = 'https://assets.hubsell.com/integrations';
const LOGOS: Record<string, string> = {
  Salesforce: `${LOGO}/699f00ff691f45081ee89059_Salesforce.svg`,
  HubSpot: `${LOGO}/699f00fe74dc92ce1ee66c09_HubSpot.svg`,
  Pipedrive: `${LOGO}/699f00ff076328750d3aefb6_f5bfffe23e979a3af1f4aca586edc14e_pipedrive.svg`,
  'Google Workspace': `${LOGO}/699f00fe9a3fab1de15bd147_G-Suite.svg`,
  'Microsoft 365': `${LOGO}/699f00fe92a407b5ca414ed7_Microsoft365.svg`,
};
const HUBSELL = 'https://assets.hubsell.com/logo/hubsell-wordmark-dark.svg';
const crms = d.items.filter((it) => it.category === 'CRM');
const mails = d.items.filter((it) => it.category === 'Email');
const groups = (['CRM', 'Email'] as const).map((cat) => ({ label: d.groups[cat], items: d.items.filter((it) => it.category === cat) }));
---
<section class="sec sec--paper" aria-labelledby="intg-title">
  <div class="wrap">
    <div class="intg-hero">
      <div class="sec-head" style="margin-bottom:0">
        <p class="eyebrow">{d.eyebrow}</p>
        <h1 id="intg-title" class="heading_hero" style="margin-top:10px">{d.h1Pre}<span class="accent">{d.h1Accent}</span>{d.h1Post}</h1>
        <p class="subheading" style="margin-top:16px;max-width:60ch">{d.sub}</p>
        <div style="margin:28px 0 0"><CtaGroup location="hero" /></div>
      </div>
      <div class="ihub" aria-hidden="true">
        <div class="ihub__col">
          <span class="ihub__cap">{d.hubLabels.mail}</span>
          {mails.map((m) => <span class="ihub__tile"><img src={LOGOS[m.name]} alt="" width="34" height="34" loading="lazy" /><b>{m.name}</b></span>)}
        </div>
        <svg class="ihub__arrow ihub__arrow--l" viewBox="0 0 60 16"><path d="M58 8 H4"/><path d="M10 2 L3 8 L10 14"/></svg>
        <div class="ihub__core"><img src={HUBSELL} alt="" width="104" height="24" /></div>
        <svg class="ihub__arrow" viewBox="0 0 60 16"><path d="M2 8 H56"/><path d="M50 2 L57 8 L50 14"/></svg>
        <div class="ihub__col">
          <span class="ihub__cap">{d.hubLabels.crm}</span>
          {crms.map((c) => <span class="ihub__tile"><img src={LOGOS[c.name]} alt="" width="34" height="34" loading="lazy" /><b>{c.name}</b></span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--sand" aria-labelledby="intg-list">
  <div class="wrap">
    <SectionHead id="intg-list" {...h.list} />
    {groups.map((g) => (
      <Fragment>
        <h3 class="intg-group">{g.label}</h3>
        <div class="intg-grid">
          {g.items.map((it) => (
            <div class="card intg-card">
              <div class="intg-top">
                <span class="intg-logo"><img src={LOGOS[it.name]} alt={`${it.name} logo`} width="32" height="32" loading="lazy" onerror="this.parentElement.dataset.missing='1'" /><b aria-hidden="true">{it.name.charAt(0)}</b></span>
                <span class="intg-live"><span class="intg-dot"></span>{d.statusLabel}</span>
              </div>
              <h4 class="heading_small" style="margin-top:16px">{it.name}</h4>
              <p class="paragraph_small" style="margin-top:10px">{it.blurb}</p>
            </div>
          ))}
        </div>
      </Fragment>
    ))}
    <div class="card intg-note">
      <h3 class="heading_small">{d.noteTitle}</h3>
      <p class="paragraph_small" style="margin-top:8px;max-width:72ch">{d.noteBody}</p>
    </div>
  </div>
</section>

<section class="sec sec--paper" aria-labelledby="intg-crm">
  <div class="wrap intg-split">
    <div><SectionHead id="intg-crm" {...h.crm} /></div>
    <div>
      <ul class="intg-points">{d.crmPoints.map((p) => <li>{p}</li>)}</ul>
      <a class="link" href={localizedHref(L, d.crmLink.href)}>{d.crmLink.label} &rarr;</a>
    </div>
  </div>
</section>

<section class="sec sec--sand" aria-labelledby="intg-mail">
  <div class="wrap intg-split">
    <div><SectionHead id="intg-mail" {...h.mail} /></div>
    <div>
      <ul class="intg-points">{d.mailPoints.map((p) => <li>{p}</li>)}</ul>
      <a class="link" href={localizedHref(L, d.mailLink.href)}>{d.mailLink.label} &rarr;</a>
    </div>
  </div>
</section>

<section class="sec sec--paper" aria-labelledby="intg-steps">
  <div class="wrap">
    <SectionHead id="intg-steps" {...h.steps} />
    <ol class="intg-steps">
      {d.steps.map((st, i) => (
        <li><span class="intg-steps__n">{i + 1}</span><h3 class="heading_small">{st.title}</h3><p class="paragraph_small" style="margin-top:8px">{st.body}</p></li>
      ))}
    </ol>
    <a class="link" href={localizedHref(L, d.stepsLink.href)} style="display:inline-block;margin-top:24px">{d.stepsLink.label} &rarr;</a>
  </div>
</section>

<section class="sec sec--sand" aria-labelledby="intg-sec">
  <div class="wrap" style="max-width:820px">
    <SectionHead id="intg-sec" {...h.security} />
    {d.security.map((p) => <p class="paragraph" style="margin-top:14px">{p}</p>)}
    <p class="intg-tm">{d.trademark}</p>
  </div>
</section>

<section class="sec sec--esp" aria-labelledby="intg-closing">
  <div class="wrap" style="text-align:center">
    <SectionHead id="intg-closing" {...h.closing} align="center" sub={d.closingSub} />
    <div style="margin:30px 0 0"><CtaGroup align="center" /></div>
  </div>
</section>

<PlatformFaqPicks L={L} tone="paper" eyebrow={h.faq.eyebrow} title={h.faq.pre + h.faq.accent + h.faq.post} titleParts={[h.faq.pre, h.faq.accent, h.faq.post]} slugs={[]} items={d.faqs} seeAll={s.faqSec.seeAll} />

<style>
  .intg-hero{ display:flex; flex-direction:column; gap:clamp(36px,5vw,56px) }
  .intg-hero > *{ min-width:0 }

  .ihub{ display:flex; align-items:center; justify-content:center; gap:clamp(12px,3vw,36px); padding:clamp(24px,4vw,44px) clamp(16px,4vw,48px); width:100%; max-width:960px; border-radius:16px; border:1px solid var(--sec-bd);
    background-color:var(--sec-card); background-image:radial-gradient(var(--sec-bd) 1.25px, transparent 1.25px); background-size:18px 18px;
    box-shadow:0 40px 80px -40px rgba(25,35,65,.35), 0 2px 8px rgba(25,35,65,.06) }
  .ihub__col{ display:flex; flex-direction:column; gap:12px; flex:1 1 0; min-width:0; max-width:260px }
  .ihub__cap{ font:600 11.5px/1.2 var(--font-body); letter-spacing:.06em; text-transform:uppercase; color:var(--sec-tx); opacity:.6; text-align:center }
  .ihub__tile{ display:flex; align-items:center; gap:12px; padding:12px 16px; border-radius:10px; background:#FFFFFF; border:1px solid var(--sec-bd); box-shadow:0 1px 2px rgba(2,6,23,.06) }
  .ihub__tile img{ width:30px; height:30px; object-fit:contain; flex:none }
  .ihub__tile b{ font:600 14px/1.2 var(--font-body); color:#192341; overflow:hidden; text-overflow:ellipsis; white-space:nowrap }
  .ihub__core{ flex:none; display:grid; place-items:center; width:150px; height:80px; border-radius:14px; background:#FFFFFF; border:2px solid var(--hl); box-shadow:0 8px 24px rgba(232,98,80,.18) }
  .ihub__core img{ width:112px; height:auto }
  .ihub__arrow{ flex:none; width:clamp(28px,5vw,60px); height:16px; color:var(--hl) }
  .ihub__arrow path{ fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round }
  @media (max-width:640px){
    .ihub{ flex-direction:column }
    .ihub__col{ max-width:none }
    .ihub__col{ width:100% }
    .ihub__arrow{ transform:rotate(90deg) }
    .ihub__arrow--l{ transform:rotate(90deg) }
    .ihub > .ihub__col:first-child{ order:0 }
  }

  .intg-grid{ display:grid; grid-template-columns:1fr; gap:20px }
  @media (min-width:640px){ .intg-grid{ grid-template-columns:repeat(2,minmax(0,1fr)) } }
  @media (min-width:960px){ .intg-grid{ grid-template-columns:repeat(3,minmax(0,1fr)) } }
  .intg-card{ display:flex; flex-direction:column }
  .intg-top{ display:flex; align-items:center; justify-content:space-between }
  .intg-logo{ width:52px; height:52px; border-radius:12px; display:grid; place-items:center; background:#FFFFFF; border:1px solid var(--sec-bd) }
  .intg-logo img{ width:32px; height:32px; object-fit:contain }
  .intg-logo b{ display:none; font:600 18px/1 var(--font-head); color:#192341 }
  .intg-logo[data-missing] img{ display:none }
  .intg-logo[data-missing] b{ display:block }
  .intg-live{ display:inline-flex; align-items:center; gap:7px; font-size:12.5px; font-weight:500; color:var(--sec-tx); opacity:.8 }
  .intg-dot{ width:7px; height:7px; border-radius:50%; background:#289B9B; box-shadow:0 0 0 3px rgba(40,155,155,.18) }
  .intg-group{ font:600 13px/1.2 var(--font-body); letter-spacing:.06em; text-transform:uppercase; opacity:.72; margin:8px 0 14px }
  .intg-grid + .intg-group{ margin-top:32px }
  .intg-note{ margin-top:28px }

  .intg-split{ display:grid; grid-template-columns:1fr; gap:8px }
  @media (min-width:960px){ .intg-split{ grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(40px,6vw,96px); align-items:start } }
  .intg-points{ list-style:none; margin:0 0 22px; padding:0; display:flex; flex-direction:column }
  .intg-points li{ padding:16px 0 16px 30px; border-top:1px solid var(--sec-bd); position:relative; font:400 16px/1.55 var(--font-body); color:var(--sec-tx) }
  .intg-points li::before{ content:'\2713'; position:absolute; left:2px; top:16px; font-weight:700; color:var(--hs-success) }

  .intg-steps{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr; gap:24px }
  @media (min-width:860px){ .intg-steps{ grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(28px,4vw,56px) } }
  .intg-steps li{ border-top:1px solid var(--sec-bd); padding-top:20px }
  .intg-steps__n{ display:block; font:600 15px/1 var(--font-head); color:var(--accent-on); margin-bottom:12px }
  .intg-tm{ margin:24px 0 0; font:400 12px/1.5 var(--font-body); color:var(--sec-tx); opacity:.6 }
</style>
