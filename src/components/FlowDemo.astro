---
// Homepage hero as a working copy of the hubsell flow canvas.
//
// The visitor picks one of six sources and runs. The flow is drawn top to
// bottom, the way flows look in the app, and each card appears as the run
// reaches it. LinkedIn sources go: source, qualify, enrich, connection request,
// then a follow-up condition. Accepted gets a message, an email and a call task.
// Not accepted waits 7 days, has the invite withdrawn, then gets an email and a
// call task. A CSV import is verified first, gaps are enriched, and only people
// with a LinkedIn profile enter the LinkedIn steps. Everything ends in the CRM
// and the loop edge returns to the source.
//
// The founder's note on demos is that people lean in once they see the whole
// thing come together, so the run reveals the flow rather than showing it all
// up front.
//
// Node visuals follow the app's style guide (linkedin-post-client, branch
// styleguide: lib/styleGuide/workflowNode.ts, WorkflowNode.tsx, app/globals.css).
// Cards are 344px as in the app. When a flow is wider than the screen the
// canvas scrolls sideways rather than shrinking the cards.
//
// Geometry is computed here at build time from fixed node sizes, so nothing is
// measured in the browser. The script only reveals and fills in numbers.
import { SOURCES, RATES, FLOW_COPY } from '../data/flow-demo';
import { asLocale } from '../i18n/utils';

const L = asLocale(Astro.currentLocale);
const C = FLOW_COPY[L as keyof typeof FLOW_COPY] ?? FLOW_COPY.en;
const N = C.n;
// Numbers come from SOURCES, words from the locale's copy.
const SRC = SOURCES.map((s) => ({ ...s, ...C.src[s.id], sample: s.id === 'hiring' ? C.ui.rolesSample : s.sample }));
const payload = JSON.stringify({ SOURCES: SRC, RATES, UI: C.ui, NUM: C.numberLocale, PCT_SPACE: C.pctSpace });

// embed: render only the app window, for a hero that brings its own heading.
const { embed = false } = Astro.props as { embed?: boolean };
const Tag = embed ? 'div' : 'section';

// Lucide outlines, inner markup only, same convention as pricing-feature-icons.
const I: Record<string, string> = {
  link:    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  calendar:'<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  brief:   '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  search:  '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  compass: '<path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/><circle cx="12" cy="12" r="10"/>',
  sheet:   '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/>',
  users:   '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  spark:   '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  shield:  '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  mailOk:  '<path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h8"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/><path d="m16 19 2 2 4-4"/>',
  phone:   '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  plus:    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/>',
  minus:   '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="22" x2="16" y1="11" y2="11"/>',
  send:    '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
  ok:      '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  ban:     '<circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/>',
  x:       '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
  branch:  '<line x1="6" x2="6" y1="3" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  msg:     '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  reply:   '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  mail:    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  open:    '<path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/><path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>',
  sync:    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
  cal:     '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>',
  clock:   '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  task:    '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
};
const SRC_ICON: Record<string, string> = { post: 'link', event: 'calendar', hiring: 'brief', search: 'search', salesnav: 'compass', csv: 'sheet' };

// ---- flow definitions ----
type Tone = 'ok' | 'no' | 'neutral';
type Stat = [label: string, key: string, icon: string, tone: Tone];
type Node =
  | { type: 'card'; id: string; badge: string; ico: string; t: string; s: string; stats: Stat[]; call?: boolean }
  | { type: 'chip'; id: string; badge: string; ico: string; t: string; s: string }
  | { type: 'wait'; id: string; t: string }
  | { type: 'gap'; id: string }
  | { type: 'label'; id: string; t: string; tone: Tone; k?: string };
type Item = Node | { branch: Item[][] };

let uid = 0;
const wait = (t: string): Node => ({ type: 'wait', id: `w${uid++}`, t });
// An empty row the size of a wait. It keeps parallel tracks on the same rows,
// so matching steps (the two emails, the two call tasks) line up across.
const gap = (): Node => ({ type: 'gap', id: `g${uid++}` });
const callTask = (key: string): Node => ({ type: 'card', id: `call-${key}`, badge: 'violet', ico: 'task', t: N.call, s: N.callSub, call: true,
  stats: [[N.tasks, key, 'phone', 'ok']] });
const emailStep = (p: string, s = N.emailSub): Node => ({ type: 'card', id: `email-${p}`, badge: 'violet', ico: 'mail', t: N.email, s,
  stats: [[N.sent, `${p}ES`, 'send', 'ok'], [N.opened, `${p}EO`, 'open', 'ok'], [N.replied, `${p}ER`, 'reply', 'ok']] });

// LinkedIn steps blue, email and automation violet, goals green: the style
// guide's colour rule.
const linkedinTracks = (): Item[] => [
  { type: 'card', id: 'connect', badge: 'blue', ico: 'plus', t: N.connect, s: N.connectSub,
    stats: [[N.sent, 'CS', 'send', 'ok'], [N.accepted, 'CA', 'ok', 'ok'], [N.notAccepted, 'CN', 'ban', 'no']] },
  { type: 'chip', id: 'cond', badge: 'violet', ico: 'branch', t: N.cond, s: N.condSub },
  { branch: [
    [
      { type: 'label', id: 'l-acc', t: N.branchAcc, tone: 'ok', k: 'CA' },
      wait(N.wait1),
      { type: 'card', id: 'dm', badge: 'blue', ico: 'msg', t: N.dm, s: N.dmSub,
        stats: [[N.sent, 'MS', 'send', 'ok'], [N.replied, 'MR', 'reply', 'ok']] },
      wait(N.wait3),
      emailStep('A'),
      wait(N.wait2),
      callTask('AC'),
    ],
    [
      { type: 'label', id: 'l-not', t: N.branchNot, tone: 'no', k: 'CN' },
      wait(N.wait7),
      { type: 'card', id: 'withdraw', badge: 'blue', ico: 'minus', t: N.withdraw, s: N.withdrawSub,
        stats: [[N.withdrawn, 'WD', 'minus', 'neutral']] },
      gap(),
      emailStep('N'),
      wait(N.wait2),
      callTask('NC'),
    ],
  ] },
];

const sync: Node = { type: 'card', id: 'sync', badge: 'green', ico: 'sync', t: N.sync, s: N.syncSub,
  stats: [[N.synced, 'SY', 'sync', 'neutral'], [N.replies, 'R', 'reply', 'ok'], [N.meetings, 'M', 'cal', 'ok']] };

const FLOW_LI: Item[] = [
  { type: 'card', id: 'source', badge: 'violet', ico: 'link', t: N.source, s: SRC[0].tab,
    stats: [[N.found, 'F', 'users', 'neutral']] },
  { type: 'card', id: 'qualify', badge: 'violet', ico: 'spark', t: N.qualify, s: N.qualifySub,
    stats: [[N.checked, 'F', 'users', 'neutral'], [N.qualified, 'Q', 'ok', 'ok'], [N.notFit, 'NF', 'x', 'no']] },
  { type: 'card', id: 'enrich', badge: 'violet', ico: 'mailOk', t: N.enrich, s: N.enrichSub,
    stats: [[N.emails, 'E', 'mailOk', 'ok'], [N.phones, 'P', 'phone', 'ok']] },
  ...linkedinTracks(),
  sync,
];

const FLOW_CSV: Item[] = [
  { type: 'card', id: 'source', badge: 'violet', ico: 'sheet', t: N.importCsv, s: 'sample-leads.csv',
    stats: [[N.rows, 'F', 'users', 'neutral']] },
  { type: 'card', id: 'verify', badge: 'violet', ico: 'shield', t: N.verify, s: N.verifySub,
    stats: [[N.validEmail, 'VE', 'mailOk', 'ok'], [N.validProfile, 'VL', 'link', 'ok']] },
  { type: 'card', id: 'enrich', badge: 'violet', ico: 'mailOk', t: N.enrichGaps, s: N.enrichGapsSub,
    stats: [[N.emails, 'EF', 'mailOk', 'ok'], [N.profiles, 'LF', 'link', 'ok'], [N.phones, 'P', 'phone', 'ok']] },
  { type: 'chip', id: 'cond0', badge: 'violet', ico: 'branch', t: N.cond, s: N.condProfile },
  { branch: [
    [{ type: 'label', id: 'l-li', t: N.hasProfile, tone: 'ok', k: 'YL' }, ...linkedinTracks()],
    [{ type: 'label', id: 'l-em', t: N.emailOnly, tone: 'neutral', k: 'NL' }, emailStep('O', N.emailSubAll), wait(N.wait2), callTask('OC')],
  ] },
  sync,
];

// ---- layout ----
// Fixed sizes so geometry needs no measuring. Cards are the style guide's 344.
const SIZE = { card: [344, 128], chip: [252, 64], wait: [168, 34], gap: [168, 34], label: [156, 30] } as const;
const GX = 56, GY = 44, PAD = 40, LANE = 34;

type Placed = Node & { x: number; y: number; w: number; h: number; cx: number; step: number };
type Edge = { d: string; step: number; loop?: boolean };
type Exit = { x: number; y: number; split?: boolean };

function path(pts: number[][], r = 12) {
  const p = pts.filter((q, i) => i === 0 || q[0] !== pts[i - 1][0] || q[1] !== pts[i - 1][1]);
  let d = `M${p[0][0]},${p[0][1]}`;
  for (let i = 1; i < p.length - 1; i++) {
    const [px, py] = p[i - 1], [cx, cy] = p[i], [nx, ny] = p[i + 1];
    const lin = Math.hypot(cx - px, cy - py), lout = Math.hypot(nx - cx, ny - cy);
    const rr = Math.min(r, lin / 2, lout / 2);
    const ax = cx - ((cx - px) / lin) * rr, ay = cy - ((cy - py) / lin) * rr;
    const bx = cx + ((nx - cx) / lout) * rr, by = cy + ((ny - cy) / lout) * rr;
    d += ` L${ax},${ay} Q${cx},${cy} ${bx},${by}`;
  }
  const [lx, ly] = p[p.length - 1];
  return d + ` L${lx},${ly}`;
}

const widthOf = (seq: Item[]): number => Math.max(...seq.map((it) =>
  'branch' in it ? it.branch.reduce((a, s) => a + widthOf(s), 0) + GX * (it.branch.length - 1) : SIZE[it.type][0]));

function layout(flow: Item[]) {
  const nodes: Placed[] = [], edges: Edge[] = [];
  const left = PAD + LANE;
  const W = widthOf(flow);

  function place(seq: Item[], cx: number, y: number, step: number, exits: Exit[]): { y: number; step: number; exits: Exit[] } {
    for (const it of seq) {
      if ('branch' in it) {
        const total = it.branch.reduce((a, s) => a + widthOf(s), 0) + GX * (it.branch.length - 1);
        let x = cx - total / 2, maxY = y, maxStep = step;
        const out: Exit[] = [];
        for (const s of it.branch) {
          const w = widthOf(s);
          const r = place(s, x + w / 2, y, step, exits.map((e) => ({ ...e, split: true })));
          out.push(...r.exits); maxY = Math.max(maxY, r.y); maxStep = Math.max(maxStep, r.step);
          x += w + GX;
        }
        y = maxY; step = maxStep; exits = out;
        continue;
      }
      const [w, h] = SIZE[it.type];
      if (it.type === 'gap') { y += h + GY; step++; continue; }   // the incoming edge just runs longer
      nodes.push({ ...it, x: cx - w / 2, y, w, h, cx, step });
      for (const e of exits) {
        const turn = e.split ? e.y + GY / 2 : y - GY / 2;
        edges.push({ step, d: path([[e.x, e.y], [e.x, turn], [cx, turn], [cx, y]]) });
      }
      exits = [{ x: cx, y: y + h }];
      y += h + GY;
      step++;
    }
    return { y, step, exits };
  }

  const r = place(flow, left + W / 2, PAD, 0, []);
  const src = nodes[0], end = nodes[nodes.length - 1];
  const laneX = PAD / 2 + 4, loopY = end.y + end.h + 26;
  edges.push({ step: r.step, loop: true,
    d: path([[end.cx, end.y + end.h], [end.cx, loopY], [laneX, loopY], [laneX, src.y + src.h / 2], [src.x, src.y + src.h / 2]], 16) });
  return { nodes, edges, steps: r.step, W: left + W + PAD, H: loopY + 40, loop: { x: (laneX + end.cx) / 2, y: loopY } };
}

const GRAPHS = [
  { id: 'li', g: layout(FLOW_LI) },
  { id: 'csv', g: layout(FLOW_CSV) },
];
---
<Tag class:list={[!embed && 'sec sec--navy', 'fd', embed && 'fd--embed']} aria-labelledby={embed ? undefined : 'fd-title'}>
  {!embed && <div class="wrap">
    <div class="fd__head">
      <h1 id="fd-title" class="heading_primary">Book the same pipeline using 50 times fewer prospects.</h1>
      <p class="subheading fd__lede">
        Pick where your prospects come from. hubsell qualifies them, finds verified emails and phones, and runs
        LinkedIn, email and call tasks in one flow. Invites nobody accepts are withdrawn after 7 days and those
        people get an email instead. Every reply lands in your CRM. See it below.
      </p>
    </div>
  </div>}

  <div class="fd__bleed">
    <div class="fd__app" data-fd>
      <div class="fd__chrome">
        <span class="fd__crumb">{C.ui.flows} <i>/</i> <b data-crumb>{SRC[0].crumb}</b></span>
        <span class="fd__tag">{C.ui.sample}</span>
      </div>

      <form class="fd__ctrl" data-fd-form novalidate>
        <div class="fd__tabs" role="radiogroup" aria-label={C.ui.source}>
          {SRC.map((s, i) => (
            <label class="fd__tab">
              <input type="radio" name="src" value={s.id} checked={i === 0} />
              <span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I[SRC_ICON[s.id]]} />
                {s.tab}
              </span>
            </label>
          ))}
        </div>
        <div class="fd__row">
          <label class="fd__in" data-in="url">
            <span class="fd__sr" data-in-label>{SRC[0].label}</span>
            <input type="text" name="url" value={SRC[0].sample} spellcheck="false" autocomplete="off" data-fd-url />
          </label>
          <label class="fd__in fd__in--text" data-in="text" hidden>
            <span class="fd__pre">{C.ui.roles}</span>
            <input type="text" name="roles" value={C.ui.rolesSample} autocomplete="off" aria-label={SRC.find((s) => s.id === 'hiring')!.label} />
          </label>
          <div class="fd__in fd__file" data-in="file" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.sheet} />
            <span><b>sample-leads.csv</b> {C.ui.file}</span>
          </div>
          <div class="fd__opts">
            <label class="fd__chk"><input type="checkbox" checked disabled /><span>{C.ui.verified}</span></label>
            <label class="fd__chk"><input type="checkbox" name="phone" checked /><span>{C.ui.phone} <small>{C.ui.credit}</small></span></label>
          </div>
        </div>
      </form>

      <div class="fd__stage">
      <div class="fd__vp" data-fd-vp>
        {GRAPHS.map(({ id, g }) => (
          <div class="fd__world" data-graph={id} data-steps={g.steps} hidden={id !== 'li'}
               style={`width:${g.W}px;--h:${g.H}px;height:${g.nodes[0].y + g.nodes[0].h + 40}px`}>
            <svg class="fd__edges" width={g.W} height={g.H} viewBox={`0 0 ${g.W} ${g.H}`} aria-hidden="true">
              {g.edges.map((e) => <path class:list={['fd__e', e.loop && 'fd__e--loop']} data-step={e.step} d={e.d} fill="none" />)}
              {g.edges.map((e) => <path class:list={['fd__p', e.loop && 'fd__p--loop']} data-step={e.step} pathLength="1" d={e.d} fill="none" />)}
            </svg>
            <span class="fd__el" data-step={g.steps} style={`left:${g.loop.x}px;top:${g.loop.y}px`}>{C.ui.repeat}</span>

            {g.nodes.map((n) => {
              const pos = `left:${n.x}px;top:${n.y}px;width:${n.w}px;height:${n.h}px`;
              const common = { 'data-step': n.step, 'data-cx': n.cx, 'data-bottom': n.y + n.h, style: pos };
              if (n.type === 'wait') return (
                <div class="fd__it wt" {...common}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I.clock} />
                  {n.t}
                </div>
              );
              if (n.type === 'label') return (
                <div class:list={['fd__it', 'wl', `wl--${n.tone}`]} {...common}>{n.t}{n.k && <b data-k={n.k}></b>}</div>
              );
              return (
                <div class:list={['fd__it', 'wn', `wn--${n.type}`, n.step === 0 && 'is-in']} data-n={n.id} data-call={n.type === 'card' && n.call ? '1' : undefined} {...common}>
                  {n.id !== 'source' && <span class="wn__h wn__h--in" aria-hidden="true"></span>}
                  {n.id === 'source' && <span class="wn__h wn__h--side" aria-hidden="true"></span>}
                  <span class="wn__h wn__h--out" aria-hidden="true"></span>
                  <div class="wn__hd">
                    <span class:list={['wb', n.type === 'chip' ? 'wb--lg' : 'wb--md', `wb--${n.badge}`]} aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-ico={n.id === 'source' ? 'src' : undefined} set:html={I[n.ico]} />
                    </span>
                    <span class="wn__tt">
                      <b>{n.t}</b>
                      <span data-sub={n.id === 'source' ? 'src' : undefined}>{n.s}</span>
                    </span>
                    {n.type === 'card' && <span class="wp" data-pill><i></i><span>{C.ui.off}</span></span>}
                  </div>
                  {n.type === 'card' && (
                    <dl class="wn__st" style={`grid-template-columns:repeat(${n.stats.length},minmax(0,1fr))`}>
                      {n.stats.map(([label, key, ico, tone]) => (
                        <div>
                          <dt>{label}</dt>
                          <dd>
                            <svg class={`ws ws--${tone}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={I[ico]} />
                            <b data-k={key}>-</b><small data-r={key}></small>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </div>
              );
            })}
          </div>
        ))}
      </div>

      </div>
    </div>
  </div>
</Tag>

<script define:vars={{ payload, I, SRC_ICON }}>
  const D = JSON.parse(payload);
  const R = D.RATES;
  const r = Math.round;
  const U = D.UI;
  const fmt = (n) => Math.round(n).toLocaleString(D.NUM);
  const pct = (a, b) => (b ? (Math.round((a / b) * 1000) / 10).toLocaleString(D.NUM, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + (D.PCT_SPACE ? '\u00a0%' : '%') : '');
  const sleep = (ms) => new Promise((res) => setTimeout(res, ms));

  // The two LinkedIn tracks, shared by every source that reaches them. Rounded
  // at each step so the canvas adds up: accepted plus not accepted is exactly
  // what was sent.
  function tracks(N, w, emailR, phoneR, p) {
    const CA = r(N * R.accept * w), CN = N - CA, MR = r(CA * R.msgReply * w);
    const AES = r((CA - MR) * emailR), AEO = r(AES * R.open), AER = r(AES * R.emailReply * w);
    const AC = r((CA - MR - AER) * phoneR);
    const NES = r(CN * emailR), NEO = r(NES * R.open), NER = r(NES * R.emailReply * w);
    const NC = r((CN - NER) * phoneR);
    Object.assign(p.v, { CS: N, CA, CN, MS: CA, MR, AES, AEO, AER, AC, WD: CN, NES, NEO, NER, NC });
    Object.assign(p.rates, { CA: pct(CA, N), CN: pct(CN, N), MR: pct(MR, CA), AEO: pct(AEO, AES), AER: pct(AER, AES), NEO: pct(NEO, NES), NER: pct(NER, NES) });
    return { replies: MR + AER + NER, calls: AC + NC };
  }

  function compute(src, phone) {
    const w = src.warmth, F = src.found;
    const p = { v: { F }, rates: {} };
    let replies, calls;
    if (src.flow === 'li') {
      const Q = r(F * R.qualify), E = r(Q * R.email), P = phone ? r(Q * R.phone) : 0;
      Object.assign(p.v, { Q, NF: F - Q, E, P, SY: Q });
      Object.assign(p.rates, { Q: pct(Q, F), NF: pct(F - Q, F), E: pct(E, Q), P: phone ? pct(P, Q) : '' });
      ({ replies, calls } = tracks(Q, w, E / Q, P / Q, p));
    } else {
      const VE = r(F * R.csvEmail), VL = r(F * R.csvProfile);
      const EF = r((F - VE) * R.findEmail), LF = r((F - VL) * R.findProfile);
      const P = phone ? r(F * R.csvPhone) : 0;
      const YL = VL + LF, NL = F - YL, emailR = (VE + EF) / F, phoneR = P / F;
      Object.assign(p.v, { VE, VL, EF, LF, P, YL, NL, SY: F });
      Object.assign(p.rates, { VE: pct(VE, F), VL: pct(VL, F) });
      ({ replies, calls } = tracks(YL, w, emailR, phoneR, p));
      const OES = r(NL * emailR), OEO = r(OES * R.open), OER = r(OES * R.emailReply * w), OC = r((NL - OER) * phoneR);
      Object.assign(p.v, { OES, OEO, OER, OC });
      Object.assign(p.rates, { OEO: pct(OEO, OES), OER: pct(OER, OES) });
      replies += OER; calls += OC;
    }
    p.v.R = replies;
    p.v.M = r(replies * R.meeting + calls * R.callMeeting);
    p.v.bulk = F * R.bulkFactor;
    return p;
  }

  function detect(url) {
    if (url.includes('linkedin.com/posts')) return 'post';
    if (url.includes('linkedin.com/events')) return 'event';
    if (url.includes('sales/search/people')) return 'salesnav';
    if (url.includes('search/results/people')) return 'search';
    return null;
  }

  // alive() goes false when a newer run starts, so an old count stops
  // writing into a card that has been reset.
  function countTo(el, to, ms, alive = () => true) {
    if (!ms) { el.textContent = fmt(to); return; }
    const t0 = performance.now();
    const tick = (now) => {
      if (!alive()) return;
      const k = Math.min(1, (now - t0) / ms);
      el.textContent = fmt(to * (1 - Math.pow(1 - k, 3)));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }


  function init() {
    document.querySelectorAll('[data-fd]').forEach((root) => {
      if (root.dataset.fdReady) return;
      root.dataset.fdReady = '1';

      const form = root.querySelector('[data-fd-form]');
      const url = root.querySelector('[data-fd-url]');
      const vp = root.querySelector('[data-fd-vp]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Each run takes a number. Changing the source or the phone option starts
      // a new run, and the old one stops at its next step.
      let gen = 0, seen = false;
      let src = D.SOURCES[0];
      let world = root.querySelector('[data-graph="li"]');

      // The site's smooth scrolling (Lenis) takes every wheel event for the
      // page unless the element opts out. Opt out only while the canvas has
      // something to scroll, so an empty canvas never traps the page.
      const scrollable = () => {
        const v = vp.scrollHeight > vp.clientHeight + 2 || vp.scrollWidth > vp.clientWidth + 2;
        vp.toggleAttribute('data-lenis-prevent', v);
      };
      new ResizeObserver(scrollable).observe(vp);
      root.querySelectorAll('[data-graph]').forEach((g) => g.addEventListener('transitionend', (e) => { if (e.target === g) scrollable(); }));

      // The canvas is only as tall as what has been revealed, so it grows
      // downward as the run reaches each card.
      const fitHeight = () => {
        let b = 0;
        world.querySelectorAll('.fd__it.is-in').forEach((n) => (b = Math.max(b, +n.dataset.bottom)));
        const full = world.style.getPropertyValue('--h');
        world.style.height = world.classList.contains('is-complete')
          ? full : (b + 40) + 'px';
        scrollable();
      };

      const reset = () => {
        world.classList.remove('is-complete');
        world.querySelectorAll('.fd__it').forEach((n) => {
          n.classList.remove('is-in', 'is-active', 'is-done');
          const pill = n.querySelector('[data-pill]');
          if (pill) { pill.dataset.pill = ''; pill.querySelector('span').textContent = U.off; }
        });
        world.querySelectorAll('[data-k]').forEach((x) => { x.textContent = x.closest('.wl') ? '' : '-'; x.classList.remove('is-off'); });
        world.querySelectorAll('[data-r]').forEach((x) => (x.textContent = ''));
        world.querySelectorAll('.fd__e, .fd__p, .fd__el').forEach((e) => e.classList.remove('is-in', 'is-run'));
        world.querySelector('[data-step="0"].fd__it').classList.add('is-in');
        const sub = world.querySelector('[data-sub="src"]');
        if (sub) sub.textContent = src.flow === 'csv' ? src.sample : src.tab;
        const ico = world.querySelector('[data-ico="src"]');
        if (ico) ico.innerHTML = I[SRC_ICON[src.id]];
        fitHeight();
      };

      const setSource = (id) => {
        src = D.SOURCES.find((s) => s.id === id);
        root.querySelector('[data-crumb]').textContent = src.crumb;
        root.querySelectorAll('[data-in]').forEach((el) => (el.hidden = el.dataset.in !== src.input));
        root.querySelector('[data-in-label]').textContent = src.label;
        if (src.input === 'url' && detect(url.value) !== id) url.value = src.sample;
        root.querySelectorAll('[data-graph]').forEach((g) => (g.hidden = g.dataset.graph !== src.flow));
        world = root.querySelector(`[data-graph="${src.flow}"]`);
        reset();
        // Start centred on the source card, which matters when the flow is
        // wider than the window, as it is on a phone.
        const first = world.querySelector('[data-step="0"].fd__it');
        vp.scrollTo({ left: Math.max(0, +first.dataset.cx + world.offsetLeft - vp.clientWidth / 2), top: 0 });
      };

      form.querySelectorAll('input[name="src"]').forEach((el) =>
        el.addEventListener('change', () => { setSource(el.value); if (seen) run(); }));
      form.querySelector('input[name="phone"]').addEventListener('change', () => { if (seen) run(); });

      // Pasting a link switches to the matching source, which is what makes the
      // control feel like the product rather than a form.
      url.addEventListener('input', () => {
        const id = detect(url.value);
        if (id && id !== src.id) {
          form.querySelector(`input[name="src"][value="${id}"]`).checked = true;
          setSource(id);
          if (seen) run();
        }
      });

      // The window keeps its size and the canvas scrolls inside it, so the
      // page never moves under the visitor. Follow the newest cards down, and
      // sideways when the flow is wider than the window.
      const follow = (items) => {
        const to = {};
        const bottom = Math.max(...items.map((n) => +n.dataset.bottom)) + world.offsetTop;
        const over = bottom + 40 - (vp.scrollTop + vp.clientHeight);
        if (over > 0) to.top = vp.scrollTop + over;
        if (vp.scrollWidth > vp.clientWidth + 2) {
          const cx = items.reduce((a, n) => a + +n.dataset.cx, 0) / items.length;
          to.left = cx + world.offsetLeft - vp.clientWidth / 2;
        }
        if ('top' in to || 'left' in to) vp.scrollTo({ ...to, behavior: reduce ? 'auto' : 'smooth' });
      };

      // No run button: the flow plays by itself the first time the window is
      // well into view, and again whenever the visitor changes a setting.
      async function run() {
        const my = ++gen;
        const alive = () => my === gen;
        const phone = form.querySelector('input[name="phone"]').checked;
        const { v, rates } = compute(src, phone);
        const steps = +world.dataset.steps;

        reset();

        for (let step = 0; step < steps; step++) {
          const here = [...world.querySelectorAll(`.fd__it[data-step="${step}"]`)];
          const quick = here.every((n) => !n.classList.contains('wn'));
          const beat = reduce ? 0 : quick ? 650 : 1400;
          const ms = reduce ? 0 : 900;

          world.querySelectorAll(`.fd__e[data-step="${step}"], .fd__p[data-step="${step}"]`).forEach((p) => p.classList.add('is-in', 'is-run'));
          here.forEach((n) => {
            n.classList.add('is-in', 'is-active');
            n.querySelectorAll('[data-k]').forEach((x) => {
              const key = x.dataset.k;
              if ((key === 'P' || n.dataset.call) && !phone) { x.textContent = key === 'P' ? U.off : U.skipped; x.classList.add('is-off'); return; }
              countTo(x, v[key], ms, alive);
            });
            n.querySelectorAll('[data-r]').forEach((x) => (x.textContent = rates[x.dataset.r] || ''));
            const pill = n.querySelector('[data-pill]');
            if (pill) {
              const skip = n.dataset.call && !phone;
              pill.dataset.pill = skip ? 'skip' : 'on';
              pill.querySelector('span').textContent = skip ? U.skip : U.on;
            }
            if (n.dataset.n === 'source') n.querySelector('[data-sub="src"]').textContent = src.detail;
          });
          fitHeight();
          follow(here);
          if (beat) await sleep(beat);
          if (!alive()) return;
          here.forEach((n) => { n.classList.remove('is-active'); n.classList.add('is-done'); });
        }

        // Close the loop back to the source.
        world.classList.add('is-complete');
        world.querySelectorAll(`[data-step="${steps}"]`).forEach((p) => p.classList.add('is-in', 'is-run'));
        fitHeight();

        if (!reduce) await sleep(480);                 // let the height transition finish first
        if (!alive()) return;
        scrollable();
        vp.scrollTo({ top: vp.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });
      }

      form.addEventListener('submit', (e) => { e.preventDefault(); run(); });

      setSource(src.id);
      new IntersectionObserver((entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        seen = true;
        run();
      }, { threshold: 0.35 }).observe(vp);
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .fd:not(.fd--embed){ padding-top:clamp(48px,6vw,84px) }
  .fd--embed .fd__bleed{ margin-top:0 }
  .fd__head{ max-width:800px }
  .fd .heading_primary{ text-wrap:balance }
  .fd__lede{ margin-top:16px; max-width:68ch }

  /* Wider than the text column so a CSV flow, with three tracks side by side,
     fits without scrolling on a laptop. */
  .fd__bleed{ max-width:1360px; margin:36px auto 0; padding:0 24px }

  /* The app's own tokens, from hubsell-styleguide (tokens/hubsell-tokens.css,
     copied into src/styles). They flip in dark mode, as the app does. */
  .fd__app{
    --ink:var(--hs-foreground); --mut:var(--hs-muted-foreground); --faint:var(--hs-subtle-foreground);
    --bd:var(--hs-border); --bd2:var(--hs-border-strong); --paper:var(--hs-tint); --card:var(--hs-card);
    --primary:var(--hs-primary); --hi:var(--hs-brand); --ring:var(--hs-ring);
    background:var(--card); color:var(--ink);
    border-radius:var(--radius-lg); overflow:hidden;
    box-shadow:0 30px 70px -36px rgba(0,0,0,.75);
  }

  .fd__chrome{
    display:flex; align-items:center; gap:12px;
    padding:12px 18px; border-bottom:1px solid var(--bd); background:var(--paper);
  }
  .fd__crumb{ font-size:13px; color:var(--mut); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0 }
  .fd__crumb i{ font-style:normal; opacity:.5; margin:0 4px }
  .fd__crumb b{ color:var(--ink); font-weight:600 }
  .fd__tag{
    margin-left:auto; white-space:nowrap; font-size:11.5px; font-weight:600; color:var(--mut);
    background:var(--hs-warning-muted); color:var(--hs-warning-strong); border-radius:999px; padding:4px 10px;
  }

  /* ---- controls ---- */
  .fd__ctrl{ padding:14px 18px 16px; border-bottom:1px solid var(--bd) }
  .fd__tabs{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:12px }
  .fd__tab input{ position:absolute; opacity:0; width:0; height:0 }
  .fd__tab span{
    display:inline-flex; align-items:center; gap:7px;
    font:500 13px/1 var(--font-body); color:var(--mut); white-space:nowrap;
    padding:8px 12px; border-radius:7px; border:1px solid var(--bd); background:var(--card); cursor:pointer;
    transition:border-color .2s, color .2s, background .2s;
  }
  .fd__tab svg{ width:15px; height:15px }
  .fd__tab span:hover{ border-color:var(--bd2); color:var(--ink) }
  .fd__tab input:checked + span{ color:var(--ink); background:var(--hs-muted); border-color:var(--primary) }
  .fd__tab input:focus-visible + span{ outline:2px solid var(--ring); outline-offset:2px }

  .fd__row{ display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px }
  .fd__in{ flex:1 1 340px; min-width:0; display:flex; align-items:center }
  .fd__in[hidden]{ display:none }
  .fd__in input{
    width:100%; font:400 13px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;
    color:var(--ink); background:var(--card); border:1px solid var(--bd); border-radius:var(--hs-radius-sm); padding:10px 12px;
  }
  .fd__in input:focus{ outline:2px solid var(--ring); outline-offset:1px; border-color:transparent }
  .fd__in--text input{ font-family:var(--font-body); font-size:14px; border-radius:0 7px 7px 0 }
  .fd__pre{
    flex:none; font-size:13px; font-weight:600; color:var(--mut); background:var(--paper);
    border:1px solid var(--bd2); border-right:0; border-radius:7px 0 0 7px; padding:10px 12px;
  }
  .fd__file{
    gap:10px; font-size:13px; color:var(--mut);
    border:1px dashed var(--bd2); border-radius:7px; padding:9px 12px; background:var(--paper);
  }
  .fd__file svg{ width:18px; height:18px; flex:none; color:var(--hs-success-strong) }
  .fd__file b{ color:var(--ink); font-weight:600; margin-right:4px }
  .fd__opts{ display:flex; gap:14px }
  .fd__chk{ display:inline-flex; align-items:center; gap:7px; font-size:13px; color:var(--ink); cursor:pointer; white-space:nowrap }
  .fd__chk input{ width:16px; height:16px; accent-color:var(--primary) }
  .fd__chk small{ color:var(--faint); font-size:12px }
  .fd__sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0) }

  /* ---- canvas: the style guide's dot grid ---- */
  /* A fixed window shorter than one screen, so the whole window and the
     controls above it fit in view while the flow plays. The flow grows inside
     it and scrolls there. */
  .fd__vp{
    position:relative; height:clamp(400px, 58vh, 620px);
    overflow:auto;
    background-color:var(--card);
    background-image:radial-gradient(var(--bd) 1.25px, transparent 1.25px);
    background-size:18px 18px; background-attachment:local;
  }
  .fd__world{ position:relative; margin:0 auto; transition:height .45s cubic-bezier(.22,.7,.2,1) }
  .fd__world[hidden]{ display:none }

  .fd__edges{ position:absolute; inset:0; overflow:visible; pointer-events:none }
  .fd__e{ stroke:var(--bd2); stroke-width:1.75; opacity:0; transition:opacity .3s, stroke .3s }
  .fd__e.is-in{ opacity:1; stroke:var(--faint) }
  .fd__e--loop{ stroke-dasharray:6 6 }
  .fd__e--loop.is-in{ stroke:var(--hi) }
  .fd__p{
    stroke:var(--hi); stroke-width:3; stroke-linecap:round;
    stroke-dasharray:.22 .78; stroke-dashoffset:1; opacity:0;
  }
  .fd__p--loop{ stroke-dasharray:.06 .94 }
  .fd__p.is-run{ animation:fd-flow .9s linear forwards }
  .fd__p--loop.is-run{ animation-duration:1.6s }
  @keyframes fd-flow{ 0%{ stroke-dashoffset:1; opacity:1 } 85%{ opacity:1 } 100%{ stroke-dashoffset:0; opacity:0 } }

  .fd__el{
    position:absolute; z-index:2; transform:translate(-50%,-50%);
    font:600 12px/1 var(--font-body); color:var(--hs-brand-strong); white-space:nowrap;
    background:var(--card); border:1px solid var(--bd); border-radius:999px; padding:6px 11px;
    opacity:0; transition:opacity .4s;
  }
  .fd__el.is-in{ opacity:1 }

  /* Every item waits off stage until the run reaches it. */
  .fd__it{ position:absolute; z-index:3; box-sizing:border-box; opacity:0; transform:translateY(10px); visibility:hidden;
    transition:opacity .35s, transform .35s cubic-bezier(.22,.7,.2,1), visibility 0s .35s, border-color .25s, box-shadow .25s }
  .fd__it.is-in{ opacity:1; transform:none; visibility:visible; transition:opacity .35s, transform .35s cubic-bezier(.22,.7,.2,1), border-color .25s, box-shadow .25s }

  /* ---- nodes, per WorkflowNode.tsx ---- */
  .wn{
    display:flex; flex-direction:column;
    background:var(--card); border:1px solid var(--bd); border-radius:8px;
    box-shadow:0 1px 2px rgba(2,6,23,.06);
  }
  .wn:hover{ box-shadow:0 4px 12px rgba(2,6,23,.08),0 2px 4px rgba(2,6,23,.04) }
  /* Selected, per the style guide: primary border with a brand-muted ring. */
  .wn.is-active{
    border-color:var(--primary);
    box-shadow:0 0 0 3px var(--hs-brand-muted),0 4px 12px rgba(2,6,23,.08);
  }
  .wn__h{
    position:absolute; left:50%; width:12px; height:12px; margin-left:-6px;
    background:var(--card); border:2px solid var(--bd); border-radius:50%; z-index:1;
  }
  .wn__h--in{ top:-6px }
  .wn__h--out{ bottom:-6px }
  .wn__h--side{ left:-6px; top:50%; margin:-6px 0 0 }
  .wn.is-done .wn__h, .wn.is-active .wn__h{ border-color:var(--faint) }

  .wn__hd{ display:flex; align-items:center; gap:12px; padding:14px 16px }
  .wn--chip .wn__hd{ padding:11px 14px }
  .wn__tt{ display:flex; flex-direction:column; gap:2px; min-width:0; flex:1 }
  .wn__tt b{ font:700 15px/1.2 var(--font-body); color:var(--ink) }
  .wn__tt span{ font:500 12px/1.35 var(--font-body); color:var(--mut); white-space:nowrap; overflow:hidden; text-overflow:ellipsis }
  .wn--chip .wn__tt b{ font-size:14px; font-weight:600 }

  .wb{ flex:none; display:grid; place-items:center; border-radius:6px }
  .wb--md{ width:38px; height:38px }
  .wb--md svg{ width:19px; height:19px }
  .wb--lg{ width:40px; height:40px }
  .wb--lg svg{ width:20px; height:20px }
  .wb--blue  { background:var(--hs-info-muted); color:var(--hs-info-strong) }
  .wb--violet{ background:var(--hs-brand-muted); color:var(--hs-brand-strong) }
  .wb--green { background:var(--hs-success-muted); color:var(--hs-success-strong) }

  .wp{
    flex:none; align-self:flex-start; display:inline-flex; align-items:center; gap:6px;
    height:22px; padding:0 9px; border-radius:999px;
    font:600 11px/1 var(--font-body);
    background:var(--hs-muted); color:var(--mut);
    transition:background .25s, color .25s;
  }
  .wp i{ width:6px; height:6px; border-radius:50%; background:currentColor }
  .wp[data-pill="on"]{ background:var(--hs-success-muted); color:var(--hs-success-strong) }
  .wp[data-pill="skip"]{ background:var(--hs-warning-muted); color:var(--hs-warning-strong) }

  .wn__st{ display:grid; margin:auto 0 0; border-top:1px solid var(--bd) }
  .wn__st > div{ padding:11px 16px; min-width:0 }
  .wn__st > div:nth-last-child(3), .wn__st > div:nth-last-child(3) ~ div{ padding-inline:12px }
  .wn__st > div:nth-last-child(3) dt, .wn__st > div:nth-last-child(3) ~ div dt{ letter-spacing:.01em }
  .wn__st > div + div{ border-left:1px solid var(--bd) }
  .wn__st dt{
    font:600 10.5px/1 var(--font-body); letter-spacing:.04em; text-transform:uppercase;
    color:var(--mut); margin-bottom:5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .wn__st dd{ margin:0; display:flex; align-items:center; gap:5px; white-space:nowrap }
  .ws{ width:14px; height:14px; flex:none }
  .ws--ok{ color:var(--hs-success-strong) }
  .ws--no{ color:var(--hs-destructive-strong) }
  .ws--neutral{ color:var(--mut) }
  .wn__st b{ font:700 16px/1.2 var(--font-body); font-variant-numeric:tabular-nums; color:var(--ink) }
  .wn__st b.is-off{ font-size:13px; font-weight:600; color:var(--faint) }
