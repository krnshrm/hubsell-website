---
// Static product motif for /platform/enrichment: one contact record, each field
// with what hubsell did to it and where it came from. hubsell sources and
// orchestrates every field itself; only phone numbers come from partners.
import { asLocale } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
const T = {
  en: { title: 'Contact record', done: 'Enriched', foot: 'Sourced and orchestrated by hubsell \u00b7 quality-checked before use',
    rows: [['Name', 'Cleaned', 'LinkedIn'], ['Work email', 'Validated', 'hubsell'], ['Phone', 'Sourced', 'Partner'], ['Title', 'Normalised', 'AI'], ['Company, size, industry', 'Added', 'Website']] },
  de: { title: 'Kontaktdatensatz', done: 'Angereichert', foot: 'Von hubsell recherchiert und gesteuert \u00b7 vor der Nutzung qualitätsgeprüft',
    rows: [['Name', 'Bereinigt', 'LinkedIn'], ['Geschäftliche E-Mail', 'Validiert', 'hubsell'], ['Telefon', 'Recherchiert', 'Partner'], ['Titel', 'Normalisiert', 'KI'], ['Unternehmen, Größe, Branche', 'Ergänzt', 'Website']] },
  nl: { title: 'Contactrecord', done: 'Verrijkt', foot: 'Verzameld en georkestreerd door hubsell \u00b7 gecontroleerd voor gebruik',
    rows: [['Naam', 'Opgeschoond', 'LinkedIn'], ['Zakelijk e-mailadres', 'Gevalideerd', 'hubsell'], ['Telefoon', 'Verzameld', 'Partner'], ['Functie', 'Genormaliseerd', 'AI'], ['Bedrijf, omvang, branche', 'Toegevoegd', 'Website']] },
}[L] ?? null;
const C = T ?? { title: 'Contact record', done: 'Enriched', foot: '', rows: [] };
---
<div class="enr">
  <div class="enr__top">
    <span class="enr__title">{C.title}</span>
    <span class="enr__done">&#10003; {C.done}</span>
  </div>

  <div class="enr__rows">
    {C.rows.map(([k, v, src]) => (
      <div class="enr__row"><span class="enr__k">{k}</span><span class="enr__v">{v}</span><span class="enr__src">{src}</span><span class="enr__ok">&#10003;</span></div>
    ))}
  </div>

  <div class="enr__foot">{C.foot}</div>
</div>

<style>
  .enr{background:#fff;border:1px solid #D3D8E5;border-radius:16px;padding:22px;
    width:100%;font-family:var(--font-body);color:#192341;box-shadow:0 1px 2px rgba(25,35,65,.05)}
  .enr__top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
  .enr__title{font-family:var(--font-head);font-weight:600;font-size:1.05rem}
  .enr__done{font-size:12px;font-weight:600;color:#23757E}
  .enr__rows{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
  .enr__row{display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:12px;
    background:#FEFEFE;border:1px solid #D3D8E5;border-radius:10px;padding:11px 14px}
  .enr__k{font-size:13.5px;font-weight:500;color:#192341}
  .enr__v{font-size:12px;color:#23757E;font-weight:500}
  .enr__src{font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#6B7089;
    background:#D3D8E5;border-radius:6px;padding:2px 7px}
  .enr__ok{color:#289B9B;font-weight:700;font-size:14px}
  .enr__foot{font-size:12px;color:#6B7089;border-top:1px solid #D3D8E5;padding-top:14px}
</style>
