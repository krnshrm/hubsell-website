---
// Product motif for /platform/personalisation: a buying signal and the company
// website go in, an AI draft for that one contact comes out. Sample people and
// companies, invented for the illustration.
import { asLocale } from '../i18n/utils';
const L = asLocale(Astro.currentLocale);
const T = {
  en: { signal: 'Signal', signalText: 'Liked your post “Why outbound needs fresh data”', site: 'Company website', siteText: 'Route planning software for mid-sized carriers', draft: 'AI draft', for: 'For Lena Weber, Head of Sales at Carrow Logistics',
    body: 'Hi Lena, thanks for the like on our post about fresh data. Selling route planning to carriers means reaching dispatch leads who change roles often, so an old list goes stale fast. Worth comparing notes on how your team finds them?' },
  de: { signal: 'Signal', signalText: 'Hat den Post „Warum Outbound frische Daten braucht“ geliked', site: 'Unternehmenswebsite', siteText: 'Software zur Routenplanung für mittelgroße Speditionen', draft: 'KI-Entwurf', for: 'Für Lena Weber, Head of Sales bei Carrow Logistics',
    body: 'Hallo Lena, danke fürs Liken unseres Posts über frische Daten. Wer Routenplanung an Speditionen verkauft, erreicht Disponenten, die oft die Rolle wechseln, und eine alte Liste veraltet schnell. Lohnt sich ein kurzer Austausch, wie das Team sie findet?' },
  nl: { signal: 'Signaal', signalText: 'Vond de post ‘Waarom outbound verse data nodig heeft’ leuk', site: 'Bedrijfswebsite', siteText: 'Routeplanningssoftware voor middelgrote vervoerders', draft: 'AI-concept', for: 'Voor Lena Weber, Head of Sales bij Carrow Logistics',
    body: 'Hoi Lena, bedankt voor de like op onze post over verse data. Wie routeplanning aan vervoerders verkoopt, bereikt planners die vaak van rol wisselen, en een oude lijst veroudert snel. Zin om te vergelijken hoe jullie team ze vindt?' },
}[L] ?? null;
const t = T ?? { signal: 'Signal', signalText: '', site: '', siteText: '', draft: '', for: '', body: '' };
---
<div class="prs">
  <div class="prs__in">
    <div class="prs__src"><span class="prs__lab">{t.signal}</span><span>{t.signalText}</span></div>
    <div class="prs__src"><span class="prs__lab">{t.site}</span><span>{t.siteText}</span></div>
  </div>
  <svg class="prs__arrow" viewBox="0 0 16 28" aria-hidden="true"><path d="M8 2 V24"/><path d="M2 18 L8 25 L14 18"/></svg>
  <div class="prs__card">
    <div class="prs__top"><span class="prs__title">{t.draft}</span></div>
    <p class="prs__for">{t.for}</p>
    <p class="prs__body">{t.body}</p>
  </div>
</div>

<style>
  .prs{ display:flex; flex-direction:column; align-items:center; gap:8px; width:100%; font-family:var(--font-body); color:#192341 }
  .prs__in{ display:grid; grid-template-columns:1fr 1fr; gap:10px; width:100% }
  .prs__src{ display:flex; flex-direction:column; gap:6px; padding:12px 14px; background:#fff; border:1px solid #D3D8E5; border-radius:12px; font-size:13px; line-height:1.4; box-shadow:0 1px 2px rgba(25,35,65,.05) }
  .prs__lab{ font:600 10.5px/1 var(--font-body); letter-spacing:.06em; text-transform:uppercase; color:#555A73 }
  .prs__arrow{ width:16px; height:28px; color:var(--hl) }
  .prs__arrow path{ fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round }
  .prs__card{ width:100%; background:#fff; border:2px solid var(--hl); border-radius:16px; padding:18px 20px; box-shadow:0 10px 30px rgba(232,98,80,.14) }
  .prs__title{ display:inline-block; font:600 11.5px/1 var(--font-body); padding:5px 9px; border-radius:999px; background:var(--hl-soft); color:var(--hl-ink) }
  .prs__for{ margin:12px 0 0; font-size:12px; color:#555A73 }
  .prs__body{ margin:8px 0 0; font-size:14.5px; line-height:1.55 }
</style>
